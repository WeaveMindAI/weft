target/
.env
.env.dashboard
.env.extension
# The deployment's OAuth apps (client ids + secrets). Copy
# `access-apps.example.json` to this and fill it in.
access-apps.json
restate-data
restate-data-cloud
restate-data-cloud.toml

# Database files
*.db
*.db-journal
*.db-shm
*.db-wal

# Logs
weft-logs.txt
weavemind-logs.txt

# Caches
__pycache__
node_modules/
.DS_Store

# Codegen-emitted builder-base warm-up crate (emitted by
# `codegen::emit_warmup_crate` at build time; regenerated, never hand-edited).
.weft-base-context/

# VS Code extension build output
extension-vscode/out/
extension-vscode/.vscode-test/
extension-vscode/*.vsix

# Browser extension build artifacts. The active extension's build
# dir is gitignored at extension-browser/.gitignore (which selectively
# tracks the unversioned zip + xpi).
extension-browser-v1/web-ext-artifacts/*
# NOTE: v1 archived folders (catalog-v1, crates-v1, dashboard-v1,
# extension-browser-v1, sidecars-v1) are frozen reference. Their
# generated content (catalog-link.sh symlinks, node .ts copies,
# catalog-tree.json) is committed so the archive is complete.

# Misc v1 (frozen but kept out of build)
dashboard-v1/static/projects

# The agent memory index is private working notes, not part of the public repo.
CODE_QUALITY_TRIAGE.md
packages/weft-graph/node_modules
.weft-base-context.lock

# Draft migrations: local to the machine that wrote them, collapsed into a
# released migration by `./setup.sh --migration <name> --release`.
crates/weft-task-store/migrations/*/drafts/

# mdbook build output (docs/book.toml build-dir).
docs/book/

# Bundled highlight.js for the markdown preview (built by
# `pnpm run bundle:markdown-preview`).
extension-vscode/markdown-preview/hljs.js
packages/weft-syntax/node_modules

# Example projects generate build state when opened; never commit it.
examples/*/.weft/
tangle/old

# Personal assistant setup (good-writter, prompt-engineer,
# ruthless-reviewer), ported from the user's global Kilo/Claude config into
# all three harnesses. Private to this machine, not part of the shared repo.
# Kilo: the two personas are primary agents, the reviewer a subagent.
# Claude + Codex: the personas ride as skills (auto-loaded on writing /
# prompt-design tasks), the reviewer as a subagent.
.kilo/agent/good-writter.md
.kilo/agent/prompt-engineer.md
.kilo/agent/ruthless-reviewer.md
.claude/skills/good-writter/
.claude/skills/prompt-engineer/
.claude/agents/ruthless-reviewer.md
.agents/skills/good-writter/
.agents/skills/prompt-engineer/
.codex/agents/ruthless-reviewer.toml
