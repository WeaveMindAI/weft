{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git checkout .)",
      "Bash(git checkout --:*)",
      "Bash(git checkout -- .)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)"
    ],
    "ask": [
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)"
    ]
  }
}
