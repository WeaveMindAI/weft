{
  "type": "PiAccess",
  "label": "Pi Access",
  "description": "A model provider's API key, for the Pi nodes' `access`: Anthropic, OpenAI, Gemini, OpenRouter, DeepSeek, Mistral, xAI, Groq, or any OpenAI-compatible server. One access for however many Pi nodes; each node names the model. Pi's subscription sign-ins (Claude Pro/Max, ChatGPT, GitHub Copilot, ...) are not offered: Anthropic's terms forbid offering a Claude.ai login inside another company's software, and every one of them exists only in Pi's interactive `/login`.",
  "tags": [
    "agent",
    "pi",
    "access",
    "credentials"
  ],
  "icon": "KeyRound",
  "color": "#4f46e5",
  "service": {
    "service": "pi",
    "label": "Pi",
    "doors": [
      "own"
    ],
    "acquisition": {
      "kind": "static",
      "ways": [
        {
          "id": "anthropicKey",
          "label": "Anthropic API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-ant-..."
            }
          ],
          "guide": {
            "link": "https://console.anthropic.com/settings/keys",
            "steps": [
              "Open console.anthropic.com, Settings > API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openaiKey",
          "label": "OpenAI API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://platform.openai.com/api-keys",
            "steps": [
              "Open platform.openai.com, API keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "googleKey",
          "label": "Gemini API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "AIza..."
            }
          ],
          "guide": {
            "link": "https://aistudio.google.com/apikey",
            "steps": [
              "Open aistudio.google.com, Get API key, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openrouterKey",
          "label": "OpenRouter API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-or-..."
            }
          ],
          "guide": {
            "link": "https://openrouter.ai/keys",
            "steps": [
              "Open openrouter.ai, Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "deepseekKey",
          "label": "DeepSeek API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://platform.deepseek.com/api_keys",
            "steps": [
              "Open platform.deepseek.com, API keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "mistralKey",
          "label": "Mistral API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "your Mistral API key"
            }
          ],
          "guide": {
            "link": "https://console.mistral.ai/api-keys",
            "steps": [
              "Open console.mistral.ai, API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "xaiKey",
          "label": "xAI API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "xai-..."
            }
          ],
          "guide": {
            "link": "https://console.x.ai",
            "steps": [
              "Open console.x.ai, API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "groqKey",
          "label": "Groq API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "gsk_..."
            }
          ],
          "guide": {
            "link": "https://console.groq.com/keys",
            "steps": [
              "Open console.groq.com, API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openaiCompatible",
          "label": "OpenAI-compatible server",
          "fields": [
            {
              "name": "host",
              "label": "Server address",
              "secret": false,
              "placeholder": "http://127.0.0.1:11434/v1"
            },
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://pi.dev",
            "steps": [
              "For any server that speaks the OpenAI chat API: a gateway, or a model server on your machine.",
              "Fill in its address and a key for it (any text, for a local server that takes none), and name the connection."
            ]
          }
        }
      ]
    },
    "auth": []
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[pi]",
      "widget": {
        "kind": "access"
      },
      "label": "Account"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[pi]",
      "description": "Wire into the Pi nodes' `access` input."
    }
  ]
}
