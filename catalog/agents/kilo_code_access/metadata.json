{
  "type": "KiloCodeAccess",
  "label": "Kilo Code Access",
  "description": "A Kilo Code login, for the KiloCode nodes' `access`: a Kilo API key (its gateway, billed to your Kilo account), or a model provider's key: Anthropic, OpenAI, OpenRouter, or Gemini. One access for however many KiloCode nodes; with a provider's key, the node's `model` names the provider and its model.",
  "tags": [
    "agent",
    "kilo",
    "access",
    "credentials"
  ],
  "icon": "KeyRound",
  "color": "#ffdd00",
  "service": {
    "service": "kilo_code",
    "label": "Kilo Code",
    "doors": [
      "own"
    ],
    "acquisition": {
      "kind": "static",
      "ways": [
        {
          "id": "kiloKey",
          "label": "Kilo API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "your Kilo API key"
            }
          ],
          "guide": {
            "link": "https://kilo.ai/docs/getting-started/setup-authentication",
            "steps": [
              "Open app.kilo.ai, Your Profile on your personal account (not an organization), and copy the API key at the bottom of the page.",
              "Paste it below and name the connection. Calls are billed to that Kilo account."
            ]
          }
        },
        {
          "id": "anthropicKey",
          "label": "Anthropic API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-ant-..."
            }
          ],
          "guide": {
            "link": "https://console.anthropic.com/settings/keys",
            "steps": [
              "Open console.anthropic.com, Settings > API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openaiKey",
          "label": "OpenAI API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://platform.openai.com/api-keys",
            "steps": [
              "Open platform.openai.com, API keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openrouterKey",
          "label": "OpenRouter API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-or-..."
            }
          ],
          "guide": {
            "link": "https://openrouter.ai/keys",
            "steps": [
              "Open openrouter.ai, Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "googleKey",
          "label": "Gemini API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "AIza..."
            }
          ],
          "guide": {
            "link": "https://aistudio.google.com/apikey",
            "steps": [
              "Open aistudio.google.com, Get API key, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        }
      ]
    },
    "auth": []
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[kilo_code]",
      "widget": {
        "kind": "access"
      },
      "label": "Account"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[kilo_code]",
      "description": "Wire into the KiloCode nodes' `access` input."
    }
  ]
}
