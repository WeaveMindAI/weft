{
  "type": "NanobotAccess",
  "label": "nanobot Access",
  "description": "A model provider's key, for the Nanobot nodes' `access`: Anthropic, OpenAI, OpenRouter, Gemini, DeepSeek, Mistral, or any OpenAI-compatible server. nanobot always runs on one of these. One access for however many Nanobot nodes; each node names the model.",
  "tags": [
    "agent",
    "nanobot",
    "access",
    "credentials"
  ],
  "icon": "KeyRound",
  "color": "#ff7a00",
  "service": {
    "service": "nanobot",
    "label": "nanobot",
    "doors": [
      "own"
    ],
    "acquisition": {
      "kind": "static",
      "ways": [
        {
          "id": "anthropicKey",
          "label": "Anthropic API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-ant-..."
            }
          ],
          "guide": {
            "link": "https://console.anthropic.com/settings/keys",
            "steps": [
              "Open console.anthropic.com, Settings > API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openaiKey",
          "label": "OpenAI API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://platform.openai.com/api-keys",
            "steps": [
              "Open platform.openai.com, API keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openrouterKey",
          "label": "OpenRouter API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-or-..."
            }
          ],
          "guide": {
            "link": "https://openrouter.ai/keys",
            "steps": [
              "Open openrouter.ai, Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "googleKey",
          "label": "Gemini API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "AIza..."
            }
          ],
          "guide": {
            "link": "https://aistudio.google.com/apikey",
            "steps": [
              "Open aistudio.google.com, Get API key, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "deepseekKey",
          "label": "DeepSeek API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://platform.deepseek.com/api_keys",
            "steps": [
              "Open platform.deepseek.com, API keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "mistralKey",
          "label": "Mistral API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "your Mistral API key"
            }
          ],
          "guide": {
            "link": "https://console.mistral.ai/api-keys",
            "steps": [
              "Open console.mistral.ai, API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openaiCompatible",
          "label": "OpenAI-compatible server",
          "fields": [
            {
              "name": "host",
              "label": "Server address",
              "secret": false,
              "placeholder": "http://127.0.0.1:11434/v1"
            },
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://github.com/HKUDS/nanobot",
            "steps": [
              "For any server that speaks the OpenAI chat API: a gateway, or a model server on your machine.",
              "Fill in its address and a key for it (any text, for a local server that takes none), and name the connection."
            ]
          }
        }
      ]
    },
    "auth": []
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[nanobot]",
      "widget": {
        "kind": "access"
      },
      "label": "Account"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[nanobot]",
      "description": "Wire into the Nanobot nodes' `access` input."
    }
  ]
}
