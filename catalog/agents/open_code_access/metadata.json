{
  "type": "OpenCodeAccess",
  "label": "OpenCode Access",
  "description": "A model provider's key, for the OpenCode nodes' `access`: Anthropic, OpenAI, OpenRouter, Gemini, or OpenCode Zen. One access for however many OpenCode nodes; the node's `model` names the provider and its model.",
  "tags": [
    "agent",
    "opencode",
    "access",
    "credentials"
  ],
  "icon": "KeyRound",
  "color": "#211e1e",
  "service": {
    "service": "open_code",
    "label": "OpenCode",
    "doors": [
      "own"
    ],
    "acquisition": {
      "kind": "static",
      "ways": [
        {
          "id": "anthropicKey",
          "label": "Anthropic API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-ant-..."
            }
          ],
          "guide": {
            "link": "https://console.anthropic.com/settings/keys",
            "steps": [
              "Open console.anthropic.com, Settings > API Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openaiKey",
          "label": "OpenAI API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-..."
            }
          ],
          "guide": {
            "link": "https://platform.openai.com/api-keys",
            "steps": [
              "Open platform.openai.com, API keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "openrouterKey",
          "label": "OpenRouter API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "sk-or-..."
            }
          ],
          "guide": {
            "link": "https://openrouter.ai/keys",
            "steps": [
              "Open openrouter.ai, Keys, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "googleKey",
          "label": "Gemini API key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "AIza..."
            }
          ],
          "guide": {
            "link": "https://aistudio.google.com/apikey",
            "steps": [
              "Open aistudio.google.com, Get API key, and create a key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        },
        {
          "id": "opencodeKey",
          "label": "OpenCode Zen key",
          "fields": [
            {
              "name": "key",
              "label": "API key",
              "placeholder": "your OpenCode Zen key"
            }
          ],
          "guide": {
            "link": "https://opencode.ai/docs/zen",
            "steps": [
              "Sign in to OpenCode Zen and create an API key.",
              "Paste it below and name the connection. Calls are billed to that account."
            ]
          }
        }
      ]
    },
    "auth": []
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[open_code]",
      "widget": {
        "kind": "access"
      },
      "label": "Account"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[open_code]",
      "description": "Wire into the OpenCode nodes' `access` input."
    }
  ]
}
