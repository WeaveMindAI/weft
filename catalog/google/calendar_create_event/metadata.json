{
  "type": "GoogleCalendarCreateEvent",
  "label": "Google Calendar: Create Event",
  "description": "Put an event on a calendar: timed (RFC 3339 datetimes like 2026-08-06T15:00:00+02:00) or all-day (plain YYYY-MM-DD dates), with optional description, location, and attendees.",
  "tags": [
    "google",
    "calendar"
  ],
  "icon": "CalendarPlus",
  "color": "#4285F4",
  "inputs": [
    {
      "name": "account",
      "type": "Access[google]", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/calendar.events"
      ]
    },
    {
      "name": "calendar",
      "type": "String",
      "default": "primary",
      "label": "Calendar",
      "description": "Calendar id; 'primary' is the account's main calendar.",
      "widget": {
        "kind": "select",
        "options": [
          "primary"
        ],
        "freeText": true
      }
    },
    {
      "name": "summary",
      "type": "String",
      "required": true,
      "label": "Title"
    },
    {
      "name": "start",
      "type": "String",
      "required": true,
      "label": "Start",
      "placeholder": "2026-09-03T11:00:00+02:00, or 2026-09-03 for all day"
    },
    {
      "name": "end",
      "type": "String",
      "required": true,
      "label": "End",
      "placeholder": "2026-09-03T12:00:00+02:00, or 2026-09-04 for all day"
    },
    {
      "name": "description",
      "type": "String",
      "widget": { "kind": "textarea" },
      "label": "Description"
    },
    {
      "name": "location",
      "type": "String",
      "label": "Location"
    },
    {
      "name": "attendees",
      "type": "List[String]",
      "description": "Email addresses; each gets an invitation."
    }
  ],
  "outputs": [
    {
      "name": "eventId",
      "type": "String"
    },
    {
      "name": "link",
      "type": "String"
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "all",
        "of": [
          { "kind": "input_satisfied", "port": "start" },
          { "kind": "not", "of": { "kind": "value", "field": "start", "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2}))?$" } }
        ]
      },
      "then": {
        "message": "GoogleCalendarCreateEvent '{id}' has a `start` that is neither a moment with its zone (2026-09-03T11:00:00+02:00) nor a plain date for an all-day event (2026-09-03).",
        "port": "start"
      }
    },
    {
      "when": {
        "kind": "all",
        "of": [
          { "kind": "input_satisfied", "port": "end" },
          { "kind": "not", "of": { "kind": "value", "field": "end", "matches": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2}))?$" } }
        ]
      },
      "then": {
        "message": "GoogleCalendarCreateEvent '{id}' has an `end` that is neither a moment with its zone (2026-09-03T11:00:00+02:00) nor a plain date for an all-day event (2026-09-03).",
        "port": "end"
      }
    }
  ]
}
