{
  "type": "GoogleCalendarListEvents",
  "label": "Google Calendar: List Events",
  "description": "Lists a calendar's events in a time window, recurring events expanded to instances and ordered by start, optionally filtered by a search term.",
  "tags": [
    "google",
    "calendar"
  ],
  "icon": "CalendarSearch",
  "color": "#4285F4",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/calendar.events"
      ]
    },
    {
      "name": "calendar",
      "type": "String",
      "default": "primary",
      "label": "Calendar",
      "widget": {
        "kind": "select",
        "options": [
          "primary"
        ],
        "free_text": true
      }
    },
    {
      "name": "timeMin",
      "type": "String",
      "required": true,
      "label": "From",
      "placeholder": "2026-08-06T00:00:00Z",
      "widget": {
        "kind": "datetime"
      }
    },
    {
      "name": "timeMax",
      "type": "String",
      "required": true,
      "label": "To",
      "widget": {
        "kind": "datetime"
      }
    },
    {
      "name": "query",
      "type": "String",
      "label": "Search"
    }
  ],
  "outputs": [
    {
      "name": "events",
      "type": "List[JsonDict]",
      "description": "Each event: id, summary, start, end, location, description, link."
    },
    {
      "name": "count",
      "type": "Number"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
