{
  "type": "GmailGet",
  "label": "Gmail: Get Message",
  "description": "Fetches one Gmail message by id: subject/from/to/date, text body, labels, and every attachment pulled into storage.",
  "tags": [
    "google",
    "gmail",
    "email"
  ],
  "icon": "Mail",
  "color": "#EA4335",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    },
    {
      "name": "id",
      "type": "String",
      "required": true,
      "label": "Message id"
    },
    {
      "name": "includeAttachments",
      "type": "Boolean",
      "default": true,
      "label": "Download attachments"
    }
  ],
  "outputs": [
    {
      "name": "subject",
      "type": "String"
    },
    {
      "name": "from",
      "type": "String"
    },
    {
      "name": "to",
      "type": "String"
    },
    {
      "name": "date",
      "type": "String"
    },
    {
      "name": "body",
      "type": "String",
      "description": "Plain text when available, else the HTML."
    },
    {
      "name": "bodyIsHtml",
      "type": "Boolean"
    },
    {
      "name": "threadId",
      "type": "String"
    },
    {
      "name": "snippet",
      "type": "String"
    },
    {
      "name": "labels",
      "type": "List[String]"
    },
    {
      "name": "attachments",
      "type": "List[File]"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
