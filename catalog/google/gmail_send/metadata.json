{
  "type": "GmailSend",
  "label": "Gmail: Send",
  "description": "Sends mail as a Google account through Gmail: to/cc/bcc, text and/or HTML, attachments, and replies threaded onto an original message.",
  "tags": [
    "google",
    "gmail",
    "email"
  ],
  "icon": "Send",
  "color": "#EA4335",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/gmail.send"
      ],
      "description": "Needs send-mail; a reply also needs read-headers to thread onto the original."
    },
    {
      "name": "to",
      "type": "String | List[String]",
      "label": "To"
    },
    {
      "name": "cc",
      "type": "String | List[String]",
      "label": "Cc"
    },
    {
      "name": "bcc",
      "type": "String | List[String]",
      "label": "Bcc"
    },
    {
      "name": "subject",
      "type": "String",
      "label": "Subject"
    },
    {
      "name": "text",
      "type": "String",
      "widget": { "kind": "textarea" },
      "label": "Text body"
    },
    {
      "name": "html",
      "type": "String",
      "widget": { "kind": "textarea" },
      "label": "HTML body",
      "description": "Text and/or HTML; both together send a proper alternative pair."
    },
    {
      "name": "replyTo",
      "type": "String",
      "label": "Reply to message id",
      "description": "Gmail message id to reply to in its thread (as a Gmail trigger or Get emits)."
    },
    {
      "name": "attachments",
      "type": "File | List[File]"
    }
  ],
  "outputs": [
    {
      "name": "id",
      "type": "String",
      "description": "The sent message's id."
    },
    {
      "name": "threadId",
      "type": "String"
    }
  ],
  "features": {
    "catchErrors": true,
    "oneOfRequired": [
      [
        "to",
        "cc",
        "bcc"
      ],
      [
        "text",
        "html"
      ]
    ]
  }
}
