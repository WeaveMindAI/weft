{
  "type": "GmailLabel",
  "label": "Gmail: Label",
  "description": "Adds and/or removes Gmail labels on a message, by name. A missing add-label is created; a missing remove-label fails loudly. With neither `add` nor `remove` given, the node is skipped.",
  "tags": [
    "google",
    "gmail",
    "email"
  ],
  "icon": "Tag",
  "color": "#EA4335",
  "inputs": [
    {
      "name": "account",
      "type": "Access[google]", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/gmail.modify"
      ]
    },
    {
      "name": "id",
      "type": "String",
      "required": true,
      "label": "Message id"
    },
    {
      "name": "add",
      "type": "String | List[String]",
      "label": "Add labels"
    },
    {
      "name": "remove",
      "type": "String | List[String]",
      "label": "Remove labels"
    }
  ],
  "outputs": [
    {
      "name": "labels",
      "type": "List[String]",
      "description": "The message's label ids after the change."
    }
  ],
  "features": {
    "oneOfRequired": [
      [
        "add",
        "remove"
      ]
    ]
  }
}
