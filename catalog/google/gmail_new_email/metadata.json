{
  "type": "GmailNewEmail",
  "label": "Gmail: On New Email",
  "description": "Fires once per new Gmail message matching a search query (e.g. 'label:inbox -from:me', 'has:attachment invoice'), carrying the decomposed message with attachments. Starts from the mailbox as it is at activation; older mail never replays. Each poll reads up to 500 messages, so a burst larger than that within one interval fires only its newest 500.",
  "tags": [
    "google",
    "gmail",
    "email"
  ],
  "icon": "MailPlus",
  "color": "#EA4335",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/gmail.readonly"
      ]
    },
    {
      "name": "query",
      "type": "String",
      "label": "Search query",
      "placeholder": "label:inbox",
      "description": "Gmail search query. Empty = every new message."
    },
    {
      "name": "intervalSecs",
      "type": "Number",
      "default": 60,
      "label": "Check every (seconds)",
      "widget": {
        "kind": "number",
        "min": 5,
        "step": 1
      }
    },
    {
      "name": "includeAttachments",
      "type": "Boolean",
      "default": true,
      "label": "Download attachments"
    }
  ],
  "outputs": [
    {
      "name": "id",
      "type": "String"
    },
    {
      "name": "subject",
      "type": "String"
    },
    {
      "name": "from",
      "type": "String"
    },
    {
      "name": "to",
      "type": "String"
    },
    {
      "name": "date",
      "type": "String"
    },
    {
      "name": "body",
      "type": "String"
    },
    {
      "name": "bodyIsHtml",
      "type": "Boolean"
    },
    {
      "name": "threadId",
      "type": "String"
    },
    {
      "name": "snippet",
      "type": "String"
    },
    {
      "name": "labels",
      "type": "List[String]"
    },
    {
      "name": "attachments",
      "type": "List[File]"
    }
  ],
  "firesWith": {
    "item": "{ id: String }"
  },
  "features": {
    "isTrigger": true
  }
}
