{
  "type": "GoogleDocsCreate",
  "label": "Google Docs: Create",
  "description": "Creates a Google Doc with a title and optional initial text, for example to land an LLM-written report in Drive.",
  "tags": [
    "google",
    "docs",
    "document"
  ],
  "icon": "FileText",
  "color": "#4285F4",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "https://www.googleapis.com/auth/documents"
      ]
    },
    {
      "name": "title",
      "type": "String",
      "required": true,
      "label": "Title"
    },
    {
      "name": "text",
      "type": "String",
      "widget": { "kind": "textarea" },
      "label": "Initial text"
    }
  ],
  "outputs": [
    {
      "name": "documentId",
      "type": "String"
    },
    {
      "name": "link",
      "type": "String"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
