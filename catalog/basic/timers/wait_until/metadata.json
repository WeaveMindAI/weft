{
  "type": "WaitUntil",
  "label": "Wait until",
  "description": "Pause this branch until a date and time; the run parks on a timer at no cost. `value` passes through unchanged. To wait a duration, use Wait.",
  "tags": [
    "wait",
    "until",
    "schedule",
    "timer",
    "basic"
  ],
  "icon": "CalendarClock",
  "color": "#64748b",
  "inputs": [
    {
      "name": "when",
      "type": "String",
      "required": true,
      "label": "When",
      "description": "ISO-8601, in the future: `2026-09-03T09:00:00Z` or `2026-09-03T11:00:00+02:00`.",
      "placeholder": "2026-09-03T09:00:00Z",
      "widget": {
        "kind": "datetime"
      }
    },
    {
      "name": "value",
      "type": "T",
      "accepts": ["wire"],
      "label": "Value",
      "description": "Optional value to pass through."
    }
  ],
  "outputs": [
    {
      "name": "value",
      "type": "T",
      "description": "`value`, emitted once the time has come."
    },
    {
      "name": "wokeAt",
      "type": "String",
      "description": "ISO-8601 time the wait ended."
    }
  ]
}
