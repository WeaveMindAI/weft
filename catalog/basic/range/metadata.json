{
  "type": "Range",
  "label": "Range",
  "description": "Generate the numbers from `from` (inclusive) to `to` (exclusive) by `step`, to drive a count-based `Loop(over: [\"values\"])`; the loop pulls one per iteration, so a large range is never held in memory.",
  "tags": ["number", "stream", "range", "loop"],
  "icon": "Hash",
  "color": "#64748b",
  "inputs": [
    { "name": "from", "type": "Number", "default": 0 },
    { "name": "to", "type": "Number", "required": true },
    { "name": "step", "type": "Number", "default": 1 }
  ],
  "outputs": [
    { "name": "values", "type": "Generator[Number]" }
  ],
  "validate": [
    {
      "when": {
        "kind": "any",
        "of": [
          {
            "kind": "config_equals",
            "field": "step",
            "equals": 0
          },
          {
            "kind": "config_equals",
            "field": "step",
            "equals": 0.0
          }
        ]
      },
      "then": {
        "message": "Range '{id}' has a `step` of zero, which never reaches `to`. Use a positive step to count up or a negative one to count down.",
        "level": "structural",
        "severity": "error",
        "port": "step"
      }
    }
  ],
  "features": {
    "pure": true
  }
}
