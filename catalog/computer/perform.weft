# Do one tool call from a model on a computer, and give back what the model reads as its result.
Group(call: ToolCall, computer: Infra, session: String) -> (result: String, image: Image, error: String, *tools: ActionTools) {
  # Do one tool call on a computer. `session` is the shell session its commands run in (left out, the computer's default one). `result` is what the model reads back: the action's result, or why it failed, a command's output cut to its start and end. `image` is the screenshot or zoom the action took, closed when it took none. `error` carries the failure, closed when the action worked.
  route = RouteComputerCall { call: self.call }

  screen = Group(computer: Infra, shot: Boolean, zoom: ZoomArgs, cursor: Boolean) -> (result: String, image: Image, error: String, *tools: ActionTools) {
    # Look at the screen: a screenshot, an enlarged region, or where the mouse is
    shot = Screenshot { computer: self.computer, _should_flow: self.shot }
    zoom = Zoom { computer: self.computer, args: self.zoom }
    cursor = CursorPosition { computer: self.computer, _should_flow: self.cursor }
    self.tools = {
      "anthropic": [...shot.tools.anthropic, ...zoom.tools.anthropic, ...cursor.tools.anthropic],
      "openai": [...shot.tools.openai, ...zoom.tools.openai, ...cursor.tools.openai]
    }
    self.result = FirstInOrder {
      shot: shot.result
      zoom: zoom.result
      cursor: cursor.result
      shotFailed: shot._error
      zoomFailed: zoom._error
      cursorFailed: cursor._error
    }.value
    self.image = FirstInOrder { shot: shot.image, zoom: zoom.image }.value
    self.error = FirstInOrder { shot: shot._error, zoom: zoom._error, cursor: cursor._error }.value
  }
  screen.computer = self.computer
  screen.shot = route.screenshot
  screen.zoom = route.zoom
  screen.cursor = route.cursor

  mouse = Group(computer: Infra, click: ClickArgs, drag: DragArgs, move: MoveArgs, button: MouseButtonArgs, scroll: ScrollArgs) -> (result: String, error: String, *tools: ActionTools) {
    # Work the mouse: click, drag, move, press or release a button, scroll
    click = Click { computer: self.computer, args: self.click }
    drag = Drag { computer: self.computer, args: self.drag }
    move = MoveMouse { computer: self.computer, args: self.move }
    button = MouseButton { computer: self.computer, args: self.button }
    scroll = Scroll { computer: self.computer, args: self.scroll }
    self.tools = {
      "anthropic": [...click.tools.anthropic, ...drag.tools.anthropic, ...move.tools.anthropic, ...button.tools.anthropic, ...scroll.tools.anthropic],
      "openai": [...click.tools.openai, ...drag.tools.openai, ...move.tools.openai, ...button.tools.openai, ...scroll.tools.openai]
    }
    self.result = FirstInOrder {
      click: click.result
      drag: drag.result
      move: move.result
      button: button.result
      scroll: scroll.result
      clickFailed: click._error
      dragFailed: drag._error
      moveFailed: move._error
      buttonFailed: button._error
      scrollFailed: scroll._error
    }.value
    self.error = FirstInOrder {
      click: click._error
      drag: drag._error
      move: move._error
      button: button._error
      scroll: scroll._error
    }.value
  }
  mouse.computer = self.computer
  mouse.click = route.click
  mouse.drag = route.drag
  mouse.move = route.move
  mouse.button = route.mouseButton
  mouse.scroll = route.scroll

  keyboard = Group(computer: Infra, text: TypeArgs, keys: KeyArgs) -> (result: String, error: String, *tools: ActionTools) {
    # Work the keyboard: type text, press keys
    text = TypeText { computer: self.computer, args: self.text }
    keys = PressKey { computer: self.computer, args: self.keys }
    self.tools = {
      "anthropic": [...text.tools.anthropic, ...keys.tools.anthropic],
      "openai": [...text.tools.openai, ...keys.tools.openai]
    }
    self.result = FirstInOrder { text: text.result, keys: keys.result, textFailed: text._error, keysFailed: keys._error }.value
    self.error = FirstInOrder { text: text._error, keys: keys._error }.value
  }
  keyboard.computer = self.computer
  keyboard.text = route.type
  keyboard.keys = route.key

  shell = RunCommand(session?: String) { computer: self.computer, args: route.command, session: self.session }
  # What the model reads of a command: the start and end of its output, then its exit code.
  preview = TextPreview { file: shell.output }
  said = Format(preview: String, code: Number) {
    template: "{{preview}}\n(exit code {{code}})"
    preview: preview.preview
    code: shell.exitCode
  }
  pause = Group(seconds: Number) -> (wokeAt: String, error: String, *tools: ActionTools) {
    # Wait a while. Wait is no computer node, so the tool this group performs is described here
    # SYNC: wait <-> catalog/computer/styles.rs (WAIT, MOST_SECONDS), catalog/computer/route_computer_call/mod.rs (wait)
    self.tools = {
      "anthropic": [{
        "name": "wait",
        "description": "Wait for something on the screen to finish (a page loading, an install), then take a screenshot to see it.",
        "parameters": { "type": "object", "properties": { "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 300, "description": "Seconds to wait." } }, "required": ["duration"] }
      }],
      "openai": [{
        "name": "wait",
        "description": "Wait a second for something on the screen to finish, then take a screenshot to see it.",
        "parameters": { "type": "object", "properties": {}, "required": [] }
      }]
    }
    wait = Wait { seconds: self.seconds }
    self.wokeAt = wait.wokeAt
    self.error = wait._error
  }
  pause.seconds = route.wait
  unknown = Format(name: String) {
    template: "There is no computer action called {{name}}."
    name: route.other.name
  }

  self.result = FirstInOrder {
    screen: screen.result
    mouse: mouse.result
    keyboard: keyboard.result
    shell: said.text
    shellFailed: shell._error
    previewFailed: preview._error
    pause: pause.wokeAt
    pauseFailed: pause.error
    unknown: unknown.text
    unreadable: route._error
  }.value
  self.image = screen.image
  self.error = FirstInOrder {
    screen: screen.error
    mouse: mouse.error
    keyboard: keyboard.error
    shell: shell._error
    preview: preview._error
    pause: pause.error
    unknown: unknown.text
    unreadable: route._error
  }.value

  # Every action this file performs, described once, on the node that performs it.
  self.tools = {
    "anthropic": [...screen.tools.anthropic, ...mouse.tools.anthropic, ...keyboard.tools.anthropic, ...shell.tools.anthropic, ...pause.tools.anthropic],
    "openai": [...screen.tools.openai, ...mouse.tools.openai, ...keyboard.tools.openai, ...shell.tools.openai, ...pause.tools.openai]
  }
}
