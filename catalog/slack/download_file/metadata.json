{
  "type": "SlackDownloadFile",
  "label": "Slack: Download File",
  "description": "Downloads a Slack-hosted file (an F... id, e.g. from the file-shared trigger) into storage. The file is stored with the run and deleted with it (once the run's record goes); wire it through KeepFile to keep it past that.",
  "tags": [
    "slack",
    "file"
  ],
  "icon": "Download",
  "color": "#4A154B",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "files:read"
      ],
      "description": "Needs files:read."
    },
    {
      "name": "fileId",
      "type": "String",
      "required": true,
      "label": "File id",
      "placeholder": "F0123456789"
    }
  ],
  "outputs": [
    {
      "name": "file",
      "type": "File",
      "narrowable": true
    },
    {
      "name": "filename",
      "type": "String"
    },
    {
      "name": "mimeType",
      "type": "String"
    },
    {
      "name": "sizeBytes",
      "type": "Number"
    }
  ]
}
