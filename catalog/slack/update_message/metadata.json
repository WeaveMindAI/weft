{
  "type": "SlackUpdateMessage",
  "label": "Slack: Update Message",
  "description": "Rewrites the text and/or blocks of a Slack message this app posted, addressed by channel + ts (Slack lets an app edit only its own messages).",
  "tags": [
    "slack",
    "message",
    "chat"
  ],
  "icon": "Hash",
  "color": "#4A154B",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "chat:write"
      ],
      "description": "Needs chat:write."
    },
    {
      "name": "channel",
      "type": "String",
      "required": true,
      "label": "Channel",
      "placeholder": "The channel id the message lives in",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "channels:read"
            ],
            "get": "https://slack.com/api/conversations.list?limit=200&exclude_archived=true",
            "items": "channels",
            "label": "name",
            "value": "id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "response_metadata.next_cursor"
            }
          },
          {
            "kind": "from_url",
            "pattern": "/archives/([A-Z0-9]+)"
          }
        ]
      }
    },
    {
      "name": "ts",
      "type": "String",
      "required": true,
      "label": "Message ts",
      "placeholder": "The message's timestamp id (from Send Message)"
    },
    {
      "name": "text",
      "type": "String",
      "widget": { "kind": "textarea" },
      "label": "New text"
    },
    {
      "name": "blocks",
      "type": "List[JsonDict]",
      "label": "New blocks",
      "description": "Replacement Block Kit blocks. Give text and/or blocks."
    }
  ],
  "outputs": [
    {
      "name": "ts",
      "type": "String",
      "description": "The updated message's timestamp id."
    }
  ],
  "features": {
    "catchErrors": true,
    "oneOfRequired": [
      [
        "text",
        "blocks"
      ]
    ]
  }
}
