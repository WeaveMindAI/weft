{
  "type": "SlackGetThread",
  "label": "Slack: Get Thread",
  "description": "Reads a whole Slack thread, parent first then every reply, addressed by channel + the parent's ts. Over 10000 messages fails loudly.",
  "tags": [
    "slack",
    "message",
    "thread"
  ],
  "icon": "MessagesSquare",
  "color": "#4A154B",
  "inputs": [
    {
      "name": "account",
      "type": "Access[slack]", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "channels:history"
      ],
      "description": "Needs channels:history (groups:history for private channels), and the app must be in the channel."
    },
    {
      "name": "channel",
      "type": "String",
      "required": true,
      "label": "Channel",
      "placeholder": "The channel id the thread lives in",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "channels:read"
            ],
            "get": "https://slack.com/api/conversations.list?limit=200&exclude_archived=true",
            "okPath": "ok",
            "errorPath": "error",
            "items": "channels",
            "label": "name",
            "value": "id",
            "page": {
              "cursorParam": "cursor",
              "cursorPath": "response_metadata.next_cursor"
            }
          },
          {
            "kind": "from_url",
            "pattern": "/archives/([A-Z0-9]+)"
          }
        ]
      }
    },
    {
      "name": "ts",
      "type": "String",
      "required": true,
      "label": "Parent ts",
      "placeholder": "The thread's parent message ts"
    }
  ],
  "outputs": [
    {
      "name": "messages",
      "type": "List[JsonDict]",
      "narrowable": true,
      "description": "As Slack returns them: text, user, ts, reactions, ..."
    },
    {
      "name": "count",
      "type": "Number",
      "description": "Messages in the thread, parent included."
    }
  ]
}
