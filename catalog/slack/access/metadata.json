{
  "type": "SlackAccess",
  "label": "Slack Access",
  "description": "Connects a Slack workspace for every Slack node, through the built-in app, your own Slack app, or a pasted bot token (xoxb-...). Slack allows one grant per app and workspace, so reconnecting or upgrading permissions changes the connection for every project using it. Event triggers need your own app's Socket Mode token (xapp-...) on the connection, or a weft reachable from the internet.",
  "tags": [
    "slack",
    "access",
    "oauth"
  ],
  "icon": "Hash",
  "color": "#4A154B",
  "service": {
    "service": "slack",
    "label": "Slack",
    "grants": "exclusive",
    "callback": "https",
    "acquisition": {
      "kind": "oauth2",
      "grant": {
        "kind": "authorization_code",
        "authUrl": "https://slack.com/oauth/v2/authorize",
        "pkce": false
      },
      "tokenUrl": "https://slack.com/api/oauth.v2.access",
      "scopeDelimiter": ",",
      "okPath": "ok",
      "captures": [
        {
          "name": "team",
          "path": "team.name"
        },
        {
          "name": "teamId",
          "path": "team.id"
        }
      ],
      "registrationFields": [
        {
          "name": "appToken",
          "label": "App-level token (xapp-...)",
          "optional": true,
          "secret": true,
          "placeholder": "xapp-... (only needed for event triggers; mint it under Basic Information > App-Level Tokens with the connections:write scope)"
        }
      ]
    },
    "auth": [
      {
        "kind": "header",
        "name": "Authorization",
        "value": "Bearer {token}"
      }
    ],
    "test": {
      "url": "https://slack.com/api/auth.test",
      "method": "POST",
      "okPath": "ok",
      "errorPath": "error",
      "captures": [
        {
          "name": "team",
          "path": "team"
        },
        {
          "name": "teamId",
          "path": "team_id"
        }
      ]
    },
    "identity": "{team}",
    "doors": [
      "shared",
      "own"
    ],
    "permissions": [
      {
        "id": "chat:write",
        "label": "Send messages",
        "description": "Post messages to channels the bot is in.",
        "default": true
      },
      {
        "id": "channels:read",
        "label": "List public channels",
        "description": "See the workspace's public channel list.",
        "default": true
      },
      {
        "id": "channels:history",
        "label": "Read channel messages",
        "description": "Read the message history of public channels the bot is in."
      },
      {
        "id": "groups:read",
        "label": "List private channels",
        "description": "See the private channels the bot has been invited into."
      },
      {
        "id": "groups:history",
        "label": "Read private channel messages",
        "description": "Read the message history of private channels the bot is in."
      },
      {
        "id": "im:write",
        "label": "Start direct messages",
        "description": "Open direct-message conversations to send to a user."
      },
      {
        "id": "reactions:read",
        "label": "See reactions",
        "description": "See emoji reactions (needed by the reaction trigger)."
      },
      {
        "id": "reactions:write",
        "label": "Add reactions",
        "description": "Add and remove emoji reactions on messages."
      },
      {
        "id": "files:read",
        "label": "Read shared files",
        "description": "See and download files shared in channels the bot is in."
      },
      {
        "id": "files:write",
        "label": "Upload files",
        "description": "Upload and share files into channels."
      },
      {
        "id": "users:read",
        "label": "Look up users",
        "description": "See workspace members' names and profiles."
      },
      {
        "id": "users:read.email",
        "label": "Look up users by email",
        "description": "Resolve a workspace member from their email address."
      }
    ],
    "allPermissionsUrl": "https://docs.slack.dev/reference/scopes",
    "verification": {
      "rung": "reports_permissions",
      "cost": "free"
    },
    "ownPage": {
      "paste": {
        "fields": [
          {
            "name": "token",
            "label": "Bot token",
            "placeholder": "xoxb-..."
          },
          {
            "name": "appToken",
            "label": "App-level token (xapp-...)",
            "optional": true,
            "secret": true,
            "placeholder": "xapp-... (only needed for event triggers)"
          }
        ]
      },
      "guide": {
        "link": "https://api.slack.com/apps",
        "steps": [
          "Open api.slack.com/apps and click Create New App (From scratch), picking your workspace.",
          "Under OAuth & Permissions, add the callback URL shown here as a Redirect URL.",
          "Add these bot scopes: {permissions}.",
          "Copy the Client ID and Client Secret from Basic Information into the fields below.",
          "For event triggers, enable Socket Mode and mint an app-level token with the connections:write scope under Basic Information > App-Level Tokens; paste it in the app token field."
        ]
      }
    },
    "events": {
      "messages": {
        "fields": {
          "type": "type",
          "channel": "channel",
          "user": "user",
          "text": "text",
          "bot": "bot_id",
          "thread": "thread_ts",
          "ts": "ts",
          "workspace": "team"
        },
        "account": {
          "value": "teamId",
          "path": "team_id"
        },
        "socket": {
          "connect": {
            "url": "https://slack.com/api/apps.connections.open",
            "method": "POST",
            "okPath": "ok",
            "errorPath": "error",
            "auth": [
              {
                "kind": "header",
                "name": "Authorization",
                "value": "Bearer {appToken}"
              }
            ],
            "captures": [
              {
                "name": "url",
                "path": "url"
              }
            ]
          },
          "replies": [
            {
              "whenField": "envelope_id",
              "frame": "{\"envelope_id\":\"{value}\"}"
            }
          ],
          "eventPath": "payload.event",
          "multiAccount": true
        },
        "webhook": {
          "handshake": {
            "kind": "echo_body_field",
            "path": "challenge"
          },
          "verify": {
            "kind": "hmac",
            "signature": {
              "in": "header:X-Slack-Signature",
              "pair": "=",
              "key": "v0"
            },
            "timestamp": {
              "in": "header:X-Slack-Request-Timestamp"
            },
            "concat": "v0:{timestamp}:{body}"
          },
          "eventPath": "event"
        }
      },
      "reactions": {
        "fields": {
          "type": "type",
          "emoji": "reaction",
          "user": "user",
          "channel": "item.channel",
          "ts": "item.ts",
          "messageUser": "item_user"
        },
        "account": {
          "value": "teamId",
          "path": "team_id"
        },
        "socket": {
          "connect": {
            "url": "https://slack.com/api/apps.connections.open",
            "method": "POST",
            "okPath": "ok",
            "errorPath": "error",
            "auth": [
              {
                "kind": "header",
                "name": "Authorization",
                "value": "Bearer {appToken}"
              }
            ],
            "captures": [
              {
                "name": "url",
                "path": "url"
              }
            ]
          },
          "replies": [
            {
              "whenField": "envelope_id",
              "frame": "{\"envelope_id\":\"{value}\"}"
            }
          ],
          "eventPath": "payload.event",
          "multiAccount": true
        },
        "webhook": {
          "handshake": {
            "kind": "echo_body_field",
            "path": "challenge"
          },
          "verify": {
            "kind": "hmac",
            "signature": {
              "in": "header:X-Slack-Signature",
              "pair": "=",
              "key": "v0"
            },
            "timestamp": {
              "in": "header:X-Slack-Request-Timestamp"
            },
            "concat": "v0:{timestamp}:{body}"
          },
          "eventPath": "event"
        }
      },
      "interactions": {
        "fields": {
          "type": "type",
          "callbackId": "message.metadata.event_payload.callback",
          "action": "actions.0.action_id",
          "value": "actions.0.value",
          "user": "user.id",
          "userName": "user.username",
          "channel": "channel.id",
          "ts": "message.ts",
          "responseUrl": "response_url"
        },
        "account": {
          "value": "teamId",
          "path": "team.id"
        },
        "socket": {
          "connect": {
            "url": "https://slack.com/api/apps.connections.open",
            "method": "POST",
            "okPath": "ok",
            "errorPath": "error",
            "auth": [
              {
                "kind": "header",
                "name": "Authorization",
                "value": "Bearer {appToken}"
              }
            ],
            "captures": [
              {
                "name": "url",
                "path": "url"
              }
            ]
          },
          "replies": [
            {
              "whenField": "envelope_id",
              "frame": "{\"envelope_id\":\"{value}\"}"
            }
          ],
          "eventPath": "payload"
        },
        "webhook": {
          "verify": {
            "kind": "hmac",
            "signature": {
              "in": "header:X-Slack-Signature",
              "pair": "=",
              "key": "v0"
            },
            "timestamp": {
              "in": "header:X-Slack-Request-Timestamp"
            },
            "concat": "v0:{timestamp}:{body}"
          },
          "decode": {
            "path": "payload",
            "encoding": "form_json"
          },
          "eventPath": ""
        }
      },
      "files": {
        "fields": {
          "type": "type",
          "fileId": "file_id",
          "channel": "channel_id",
          "user": "user_id"
        },
        "account": {
          "value": "teamId",
          "path": "team_id"
        },
        "socket": {
          "connect": {
            "url": "https://slack.com/api/apps.connections.open",
            "method": "POST",
            "okPath": "ok",
            "errorPath": "error",
            "auth": [
              {
                "kind": "header",
                "name": "Authorization",
                "value": "Bearer {appToken}"
              }
            ],
            "captures": [
              {
                "name": "url",
                "path": "url"
              }
            ]
          },
          "replies": [
            {
              "whenField": "envelope_id",
              "frame": "{\"envelope_id\":\"{value}\"}"
            }
          ],
          "eventPath": "payload.event",
          "multiAccount": true
        },
        "webhook": {
          "handshake": {
            "kind": "echo_body_field",
            "path": "challenge"
          },
          "verify": {
            "kind": "hmac",
            "signature": {
              "in": "header:X-Slack-Signature",
              "pair": "=",
              "key": "v0"
            },
            "timestamp": {
              "in": "header:X-Slack-Request-Timestamp"
            },
            "concat": "v0:{timestamp}:{body}"
          },
          "eventPath": "event"
        }
      }
    }
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[slack]",
      "widget": {
        "kind": "access"
      },
      "label": "Workspace"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[slack]",
      "description": "Wire into Slack nodes."
    }
  ]
}