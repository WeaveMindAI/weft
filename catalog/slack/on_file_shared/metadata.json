{
  "type": "SlackOnFileShared",
  "label": "Slack: On File Shared",
  "description": "Fires when a file is shared in a Slack channel, optionally only in one channel. Carries the file id and where it landed, never the bytes; wire Slack Download File to get the content.",
  "tags": [
    "slack",
    "trigger",
    "file"
  ],
  "icon": "FileInput",
  "color": "#4A154B",
  "firesWith": {
    "type": "String",
    "fileId?": "String",
    "channel?": "String",
    "user?": "String"
  },
  "features": {
    "isTrigger": true
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "files:read"
      ],
      "description": "Needs files:read."
    },
    {
      "name": "channel",
      "type": "String",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "channels:read"
            ],
            "get": "https://slack.com/api/conversations.list?limit=200&exclude_archived=true",
            "items": "channels",
            "label": "name",
            "value": "id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "response_metadata.next_cursor"
            }
          },
          {
            "kind": "from_url",
            "pattern": "/archives/([A-Z0-9]+)"
          }
        ]
      },
      "label": "Channel",
      "description": "Only this channel. Empty = whole workspace."
    }
  ],
  "outputs": [
    {
      "name": "fileId",
      "type": "String",
      "description": "File id (F...)."
    },
    {
      "name": "channel",
      "type": "String",
      "description": "Channel it was shared into."
    },
    {
      "name": "user",
      "type": "String",
      "description": "Who shared it."
    }
  ]
}
