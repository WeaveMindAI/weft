{
  "type": "SlackUploadFile",
  "label": "Slack: Upload File",
  "description": "Shares a stored file into a Slack channel (optionally in a thread) with an optional title and comment, through Slack's external-upload flow.",
  "tags": [
    "slack",
    "file"
  ],
  "icon": "Upload",
  "color": "#4A154B",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "files:write"
      ],
      "description": "Needs files:write."
    },
    {
      "name": "file",
      "type": "File",
      "required": true
    },
    {
      "name": "channel",
      "type": "String",
      "required": true,
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "channels:read"
            ],
            "get": "https://slack.com/api/conversations.list?limit=200&exclude_archived=true",
            "items": "channels",
            "label": "name",
            "value": "id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "response_metadata.next_cursor"
            }
          },
          {
            "kind": "from_url",
            "pattern": "/archives/([A-Z0-9]+)"
          }
        ]
      },
      "label": "Channel",
      "placeholder": "Pick a channel or paste its id"
    },
    {
      "name": "threadTs",
      "type": "String",
      "label": "Share in thread",
      "placeholder": "The parent message's ts"
    },
    {
      "name": "title",
      "type": "String",
      "label": "Title",
      "description": "Display name in Slack. Defaults to the stored file's name."
    },
    {
      "name": "comment",
      "type": "String",
      "widget": { "kind": "textarea" },
      "label": "Comment",
      "description": "Message posted alongside the file."
    }
  ],
  "outputs": [
    {
      "name": "fileId",
      "type": "String",
      "description": "Slack file id (F...)."
    },
    {
      "name": "permalink",
      "type": "String",
      "description": "A link to the shared file."
    }
  ],
  "features": {
    "catchErrors": true
  }
}
