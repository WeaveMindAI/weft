{
  "type": "SlackReact",
  "label": "Slack: React",
  "description": "Adds or removes an emoji reaction on a Slack message, addressed by channel + ts (e.g. to acknowledge a message a workflow handled).",
  "tags": [
    "slack",
    "reaction"
  ],
  "icon": "SmilePlus",
  "color": "#4A154B",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "reactions:write"
      ],
      "description": "Needs reactions:write."
    },
    {
      "name": "channel",
      "type": "String",
      "required": true,
      "label": "Channel",
      "placeholder": "The channel id the message lives in",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "channels:read"
            ],
            "get": "https://slack.com/api/conversations.list?limit=200&exclude_archived=true",
            "items": "channels",
            "label": "name",
            "value": "id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "response_metadata.next_cursor"
            }
          },
          {
            "kind": "from_url",
            "pattern": "/archives/([A-Z0-9]+)"
          }
        ]
      }
    },
    {
      "name": "ts",
      "type": "String",
      "required": true,
      "label": "Message ts",
      "placeholder": "The message's timestamp id"
    },
    {
      "name": "emoji",
      "type": "String",
      "required": true,
      "label": "Emoji",
      "placeholder": "thumbsup (with or without colons)"
    },
    {
      "name": "remove",
      "type": "Boolean",
      "default": false,
      "label": "Remove instead of add",
      "description": "Remove the reaction instead of adding it."
    }
  ],
  "outputs": [
    {
      "name": "done",
      "type": "Boolean",
      "description": "True once the change landed."
    }
  ],
  "features": {
    "catchErrors": true
  }
}
