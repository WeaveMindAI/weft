{
  "type": "SlackOnReaction",
  "label": "Slack: On Reaction",
  "description": "Fires when an emoji reaction is added to or removed from a Slack message, optionally only for one channel and one emoji. Carries the message's channel + ts, not its text.",
  "tags": [
    "slack",
    "trigger",
    "reaction"
  ],
  "icon": "SmilePlus",
  "color": "#4A154B",
  "firesWith": {
    "emoji?": "String",
    "user?": "String",
    "channel?": "String",
    "ts?": "String",
    "messageUser?": "String",
    "type": "String"
  },
  "features": {
    "isTrigger": true
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "reactions:read"
      ],
      "description": "Needs reactions:read."
    },
    {
      "name": "channel",
      "type": "String",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "channels:read"
            ],
            "get": "https://slack.com/api/conversations.list?limit=200&exclude_archived=true",
            "items": "channels",
            "label": "name",
            "value": "id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "response_metadata.next_cursor"
            }
          },
          {
            "kind": "from_url",
            "pattern": "/archives/([A-Z0-9]+)"
          }
        ]
      },
      "label": "Channel",
      "description": "Only this channel. Empty = whole workspace."
    },
    {
      "name": "emoji",
      "type": "String",
      "label": "Emoji",
      "placeholder": "eyes (with or without colons)",
      "description": "Only this emoji. Empty = any."
    },
    {
      "name": "direction",
      "type": "String",
      "default": "added",
      "widget": {
        "kind": "select",
        "options": [
          "added",
          "removed",
          "both"
        ]
      },
      "label": "Fire on",
      "description": "Added, removed, or both."
    }
  ],
  "outputs": [
    {
      "name": "emoji",
      "type": "String",
      "description": "Emoji name, no colons."
    },
    {
      "name": "user",
      "type": "String",
      "description": "Who reacted."
    },
    {
      "name": "channel",
      "type": "String",
      "description": "Channel of the reacted message."
    },
    {
      "name": "ts",
      "type": "String",
      "description": "The reacted message's ts."
    },
    {
      "name": "messageUser",
      "type": "String",
      "description": "Author of the reacted message."
    },
    {
      "name": "type",
      "type": "String",
      "description": "reaction_added or reaction_removed."
    }
  ]
}
