{
  "type": "SlackFindUser",
  "label": "Slack: Find User",
  "description": "Looks up a Slack user by email (e.g. a CRM contact to DM) or by user id (turn an event's U... into a name and profile); give exactly one.",
  "tags": [
    "slack",
    "user",
    "lookup"
  ],
  "icon": "UserSearch",
  "color": "#4A154B",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "requiresScopes": [
        "users:read"
      ],
      "description": "Needs users:read; email lookup also needs users:read.email."
    },
    {
      "name": "email",
      "type": "String",
      "label": "Email",
      "placeholder": "person@company.com"
    },
    {
      "name": "id",
      "type": "String",
      "label": "User id",
      "placeholder": "U0123456789"
    }
  ],
  "outputs": [
    {
      "name": "id",
      "type": "String",
      "description": "Slack user id (U...)."
    },
    {
      "name": "name",
      "type": "String",
      "description": "Display name, else real name."
    },
    {
      "name": "email",
      "type": "String",
      "description": "Profile email (empty without users:read.email)."
    },
    {
      "name": "timezone",
      "type": "String",
      "description": "E.g. Europe/Paris."
    },
    {
      "name": "user",
      "type": "JsonDict",
      "description": "The full user object as Slack returns it."
    }
  ],
  "features": {
    "catchErrors": true,
    "oneOfRequired": [
      [
        "email",
        "id"
      ]
    ]
  },
  "validate": [
    {
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "input_satisfied",
            "port": "email"
          },
          {
            "kind": "input_satisfied",
            "port": "id"
          }
        ]
      },
      "then": {
        "message": "SlackFindUser '{id}' has both `email` and `id`. Keep the one you want to look the user up by and remove the other.",
        "level": "structural",
        "severity": "error",
        "field": "id"
      }
    }
  ]
}
