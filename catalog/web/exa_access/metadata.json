{
  "type": "ExaAccess",
  "label": "Exa Access",
  "description": "Connect Exa, the web-search API behind Web Search, with an API key.",
  "tags": [
    "web",
    "search",
    "access"
  ],
  "icon": "KeyRound",
  "color": "#1B64F2",
  "service": {
    "service": "exa",
    "label": "Exa",
    "doors": [
      "shared",
      "own"
    ],
    "acquisition": {
      "kind": "static",
      "fields": [
        {
          "name": "key",
          "label": "API key",
          "placeholder": "exa_..."
        }
      ]
    },
    "auth": [
      {
        "kind": "header",
        "name": "x-api-key",
        "value": "{key}"
      }
    ],
    "test": {
      "url": "https://api.exa.ai/search",
      "method": "POST",
      "expect_status": 400
    },
    "identity": "exa",
    "verification": {
      "rung": "reports_validity",
      "cost": "free"
    },
    "own_page": {
      "guide": {
        "link": "https://dashboard.exa.ai/api-keys",
        "steps": [
          "Open dashboard.exa.ai and create an API key.",
          "Paste it below and name the connection."
        ]
      }
    }
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "widget": {
        "kind": "access"
      },
      "label": "Account"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access",
      "description": "Wire into Web Search."
    }
  ]
}
