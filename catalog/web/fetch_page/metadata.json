{
  "type": "FetchPage",
  "label": "Fetch Page",
  "description": "Fetch one URL as clean markdown (JavaScript rendered, boilerplate stripped), ready for an LLM step. Uses Firecrawl.",
  "tags": [
    "web",
    "scrape"
  ],
  "icon": "FileDown",
  "color": "#FF713C",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "description": "The Firecrawl access (wire a FirecrawlAccess node)."
    },
    {
      "name": "url",
      "type": "String",
      "required": true,
      "label": "URL"
    },
    {
      "name": "onlyMainContent",
      "type": "Boolean",
      "default": true,
      "label": "Main content only",
      "description": "Strip navigation, footers, and boilerplate."
    }
  ],
  "outputs": [
    {
      "name": "markdown",
      "type": "String"
    },
    {
      "name": "title",
      "type": "String"
    }
  ],
  "features": {
    "catchErrors": true
  },
  "validate": [
    {
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "config_present",
            "field": "url"
          },
          {
            "kind": "not",
            "of": {
              "kind": "config_matches",
              "field": "url",
              "regex": "(?i)^https?://"
            }
          }
        ]
      },
      "then": {
        "message": "FetchPage '{id}' has a `url` that is not a web address. Start it with http:// or https://.",
        "level": "structural",
        "severity": "error",
        "port": "url"
      }
    }
  ]
}
