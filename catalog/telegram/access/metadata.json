{
  "type": "TelegramAccess",
  "label": "Telegram Access",
  "description": "Connect a Telegram bot with the token BotFather gave you.",
  "tags": [
    "telegram",
    "access",
    "bot"
  ],
  "icon": "Send",
  "color": "#229ED9",
  "service": {
    "service": "telegram",
    "label": "Telegram",
    "acquisition": {
      "kind": "static",
      "ways": [
        {
          "fields": [
            {
              "name": "token",
              "label": "Bot token",
              "placeholder": "123456789:AA..."
            }
          ]
        }
      ]
    },
    "auth": [
      {
        "kind": "path_prefix",
        "value": "/bot{token}"
      }
    ],
    "test": {
      "url": "https://api.telegram.org/getMe",
      "okPath": "ok",
      "captures": [
        {
          "name": "botUsername",
          "path": "result.username"
        }
      ]
    },
    "identity": "@{botUsername}"
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[telegram]",
      "widget": {
        "kind": "access"
      },
      "label": "Bot"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[telegram]",
      "description": "Wire into the Telegram nodes."
    }
  ]
}
