{
  "type": "TelegramSendMessage",
  "label": "Telegram: Send Message",
  "description": "Send a text message to a chat through the connected bot.",
  "tags": [
    "telegram",
    "message",
    "bot"
  ],
  "icon": "Send",
  "color": "#229ED9",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "required": true,
      "description": "The Telegram bot access (wire a TelegramAccess node)."
    },
    {
      "name": "chatId",
      "type": "String",
      "required": true,
      "label": "Chat ID",
      "placeholder": "123456789 or @channelname",
      "description": "The chat/channel to send to (the bot must be a member)."
    },
    {
      "name": "text",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "label": "Text"
    },
    {
      "name": "parseMode",
      "type": "String",
      "exposure": "config",
      "default": "plain",
      "widget": {
        "kind": "select",
        "options": [
          "plain",
          "MarkdownV2",
          "HTML"
        ]
      },
      "label": "Formatting",
      "description": "How Telegram renders the text."
    },
    {
      "name": "buttons",
      "type": "List[JsonDict]",
      "required": false,
      "label": "Link buttons",
      "description": "Link buttons under the message: [{\"label\": \"Open\", \"url\": \"https://...\"}]."
    },
    {
      "name": "replyTo",
      "type": "Number",
      "required": false,
      "label": "Reply to message id"
    }
  ],
  "outputs": [
    {
      "name": "messageId",
      "type": "Number",
      "required": false,
      "description": "The sent message's id."
    }
  ],
  "features": {
    "isOutputDefault": true
  }
}
