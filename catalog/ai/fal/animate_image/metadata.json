{
  "type": "FalAnimateImage",
  "label": "Animate Image",
  "description": "Turn a still image into a video through fal.ai: the image is the first frame, the prompt says what happens, an optional tail image pins the last frame (on models that take one).",
  "tags": [
    "ai",
    "video",
    "image",
    "animation"
  ],
  "icon": "Film",
  "color": "#7c3aed",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "required": true,
      "description": "The fal access (wire a FalAccess node)."
    },
    {
      "name": "image",
      "type": "Image",
      "required": true,
      "description": "The first frame."
    },
    {
      "name": "prompt",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "description": "What happens in the video."
    },
    {
      "name": "tailImage",
      "type": "Image",
      "required": false,
      "description": "The last frame, for models that pin one (tail_image_url)."
    },
    {
      "name": "model",
      "type": "String",
      "exposure": "config",
      "default": "fal-ai/kling-video/v2.1/standard/image-to-video",
      "label": "Model",
      "placeholder": "Pick a model, or paste a fal route",
      "description": "The fal model route (fal.ai/models).",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "free_text": true,
        "sources": [
          {
            "kind": "list",
            "get": "https://api.fal.ai/v1/models?status=active&category=image-to-video&q={query}",
            "items": "models",
            "label": "endpoint_id",
            "value": "endpoint_id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "next_cursor"
            },
            "public": true
          }
        ]
      }
    },
    {
      "name": "params",
      "type": "JsonDict",
      "required": false,
      "description": "Model-specific extras merged into the request (duration, cfg_scale, ...). Declared knobs win."
    }
  ],
  "outputs": [
    {
      "name": "video",
      "type": "Video",
      "required": false,
      "description": "The generated video."
    }
  ],
  "display": {
    "kind": "media",
    "output": "video"
  },
  "features": {
    "isOutputDefault": true
  }
}
