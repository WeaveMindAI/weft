{
  "type": "FalGenerateVideo",
  "label": "Generate Video",
  "description": "Generate a video from a text prompt through fal.ai. The knobs target the default model; any fal text-to-video model works by setting its id and passing model-specific extras (duration, resolution, audio) in params.",
  "tags": [
    "ai",
    "video",
    "generation"
  ],
  "icon": "Clapperboard",
  "color": "#7c3aed",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "required": true,
      "description": "The fal access (wire a FalAccess node)."
    },
    {
      "name": "prompt",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "description": "What the video should show."
    },
    {
      "name": "model",
      "type": "String",
      "exposure": "config",
      "default": "fal-ai/veo3/fast",
      "label": "Model",
      "placeholder": "Pick a model, or paste a fal route",
      "description": "The fal model route (fal.ai/models).",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "free_text": true,
        "sources": [
          {
            "kind": "list",
            "get": "https://api.fal.ai/v1/models?status=active&category=text-to-video&q={query}",
            "items": "models",
            "label": "endpoint_id",
            "value": "endpoint_id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "next_cursor"
            },
            "public": true
          }
        ]
      }
    },
    {
      "name": "aspectRatio",
      "type": "String",
      "exposure": "config",
      "default": "16:9",
      "widget": {
        "kind": "select",
        "options": [
          "16:9",
          "9:16",
          "1:1"
        ]
      },
      "label": "Aspect ratio"
    },
    {
      "name": "params",
      "type": "JsonDict",
      "required": false,
      "description": "Model-specific extras merged into the request (duration, resolution, generate_audio, ...). Declared knobs win."
    }
  ],
  "outputs": [
    {
      "name": "video",
      "type": "Video",
      "required": false,
      "description": "The generated video."
    }
  ],
  "display": {
    "kind": "media",
    "output": "video"
  },
  "features": {
    "isOutputDefault": true
  }
}
