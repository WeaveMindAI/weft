{
  "type": "FalUpscaleImage",
  "label": "Upscale Image",
  "description": "Enlarge an image (2x to 4x) through fal.ai. Any fal upscaler works by setting its id.",
  "tags": [
    "ai",
    "image",
    "upscale"
  ],
  "icon": "Maximize2",
  "color": "#7c3aed",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "required": true,
      "description": "The fal access (wire a FalAccess node)."
    },
    {
      "name": "image",
      "type": "Image",
      "required": true,
      "description": "The image to enlarge."
    },
    {
      "name": "scale",
      "type": "Number",
      "exposure": "config",
      "default": 2,
      "widget": {
        "kind": "number",
        "min": 1,
        "max": 4,
        "step": 1
      },
      "label": "Scale"
    },
    {
      "name": "model",
      "type": "String",
      "exposure": "config",
      "default": "fal-ai/esrgan",
      "label": "Model",
      "placeholder": "fal-ai/esrgan",
      "description": "The fal model route (fal.ai/models)."
    },
    {
      "name": "params",
      "type": "JsonDict",
      "required": false,
      "description": "Model-specific extras merged into the request. Declared knobs win."
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "Image",
      "required": false,
      "description": "The upscaled image."
    }
  ],
  "display": {
    "kind": "media",
    "output": "image"
  }
}
