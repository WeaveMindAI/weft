{
  "type": "FalUpscaleImage",
  "label": "Upscale Image",
  "description": "Enlarge an image (2x to 4x) through fal.ai. Any fal upscaler works by setting its id.",
  "tags": [
    "ai",
    "image",
    "upscale"
  ],
  "icon": "Maximize2",
  "color": "#7c3aed",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "required": true,
      "description": "The fal access (wire a FalAccess node)."
    },
    {
      "name": "image",
      "type": "Image",
      "required": true,
      "description": "The image to enlarge."
    },
    {
      "name": "scale",
      "type": "Number",
      "exposure": "config",
      "default": 2,
      "widget": {
        "kind": "number",
        "min": 1,
        "max": 4,
        "step": 1
      },
      "label": "Scale"
    },
    {
      "name": "model",
      "type": "String",
      "exposure": "config",
      "default": "fal-ai/esrgan",
      "label": "Model",
      "placeholder": "Pick a model, or paste a fal route",
      "description": "The fal model route (fal.ai/models).",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "free_text": true,
        "sources": [
          {
            "kind": "list",
            "get": "https://api.fal.ai/v1/models?status=active&category=image-to-image&q={query}",
            "items": "models",
            "label": "endpoint_id",
            "value": "endpoint_id",
            "page": {
              "cursor_param": "cursor",
              "cursor_path": "next_cursor"
            },
            "public": true
          }
        ]
      }
    },
    {
      "name": "params",
      "type": "JsonDict",
      "required": false,
      "description": "Model-specific extras merged into the request. Declared knobs win."
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "Image",
      "required": false,
      "description": "The upscaled image."
    }
  ],
  "display": {
    "kind": "media",
    "output": "image"
  },
  "features": {
    "isOutputDefault": true
  }
}
