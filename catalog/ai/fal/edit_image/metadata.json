{
  "type": "FalEditImage",
  "label": "Edit Image",
  "description": "Change an existing image with a text instruction: edit, restyle, or inpaint (with an optional mask) through fal.ai. Any fal edit model works by setting its id.",
  "tags": [
    "ai",
    "image",
    "edit",
    "inpaint"
  ],
  "icon": "ImageUpscale",
  "color": "#7c3aed",
  "inputs": [
    {
      "name": "account",
      "type": "Access[fal]", "accepts": ["wire"],
      "required": true,
      "description": "The fal access (wire a FalAccess node)."
    },
    {
      "name": "image",
      "type": "Image",
      "required": true,
      "description": "The image to change."
    },
    {
      "name": "prompt",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "description": "What to change.",
      "placeholder": "Make the sky a sunset"
    },
    {
      "name": "mask",
      "type": "Image",
      "description": "Inpaint mask: white areas change, black areas stay (models that take mask_url)."
    },
    {
      "name": "model",
      "type": "String",
      "default": "fal-ai/flux-pro/kontext",
      "label": "Model",
      "placeholder": "Pick a model, or paste a fal route",
      "description": "The fal model route (fal.ai/models).",
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "freeText": true,
        "sources": [
          {
            "kind": "list",
            "get": "https://api.fal.ai/v1/models?status=active&category=image-to-image&q={query}",
            "items": "models",
            "label": "endpoint_id",
            "value": "endpoint_id",
            "page": {
              "cursorParam": "cursor",
              "cursorPath": "next_cursor"
            },
            "public": true
          }
        ]
      }
    },
    {
      "name": "params",
      "type": "JsonDict",
      "description": "Model-specific extras merged into the request. Declared knobs win."
    }
  ],
  "outputs": [
    {
      "name": "image",
      "type": "Image",
      "description": "The edited image."
    }
  ],
  "display": {
    "kind": "media",
    "output": "image"
  },
  "validate": [
    { "when": { "kind": "all", "of": [{ "kind": "value", "field": "model" }, { "kind": "not", "of": { "kind": "value", "field": "model", "matches": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)+$" } }] }, "then": { "message": "FalEditImage '{id}' has a `model` that is not a fal model id: write the model's route, like fal-ai/flux/dev", "field": "model" } }
  ]
}
