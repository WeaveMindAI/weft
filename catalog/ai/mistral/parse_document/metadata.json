{
  "type": "MistralParseDocument",
  "label": "Parse Document",
  "description": "Turn a PDF, scan, or image into clean markdown through Mistral's OCR (tables, layout, 100+ languages). Emits the whole document's markdown and a per-page breakdown.",
  "tags": [
    "ai",
    "document",
    "ocr"
  ],
  "icon": "ScanText",
  "color": "#FF7000",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "description": "The Mistral access (wire a MistralAccess node)."
    },
    {
      "name": "file",
      "type": "File",
      "required": true,
      "description": "The stored document (PDF, image, scan)."
    }
  ],
  "outputs": [
    {
      "name": "markdown",
      "type": "String"
    },
    {
      "name": "pages",
      "type": "List[JsonDict]",
      "description": "Each page: index and markdown."
    },
    {
      "name": "pageCount",
      "type": "Number"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
