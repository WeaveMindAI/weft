{
  "type": "MistralAccess",
  "label": "Mistral Access",
  "description": "Connect Mistral, the OCR API the Parse Document node calls, with the built-in connection or your own API key.",
  "tags": [
    "ai",
    "mistral",
    "access"
  ],
  "icon": "KeyRound",
  "color": "#FF7000",
  "service": {
    "service": "mistral",
    "label": "Mistral",
    "doors": [
      "shared",
      "own"
    ],
    "acquisition": {
      "kind": "static",
      "fields": [
        {
          "name": "key",
          "label": "API key",
          "placeholder": "..."
        }
      ]
    },
    "auth": [
      {
        "kind": "header",
        "name": "Authorization",
        "value": "Bearer {key}"
      }
    ],
    "test": {
      "url": "https://api.mistral.ai/v1/models"
    },
    "identity": "mistral",
    "verification": {
      "rung": "reports_validity",
      "cost": "free"
    },
    "own_page": {
      "guide": {
        "link": "https://console.mistral.ai/api-keys",
        "steps": [
          "Open console.mistral.ai, API Keys, and create a key.",
          "Paste it below and name the connection."
        ]
      }
    }
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "widget": {
        "kind": "access"
      },
      "label": "Account"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access",
      "description": "Wire into Parse Document's account input."
    }
  ]
}
