{
  "type": "ElevenLabsSpeakFile",
  "label": "Speak to File",
  "description": "Turn text into one spoken audio file with an ElevenLabs voice. The batch route: whole text in, whole file out. For a live token-stream voice, use the streaming speak node instead.",
  "tags": [
    "ai",
    "audio",
    "tts",
    "voice"
  ],
  "icon": "AudioLines",
  "color": "#6b6b99",
  "inputs": [
    {
      "name": "account",
      "type": "Access", "accepts": ["wire"],
      "required": true,
      "description": "The ElevenLabs access (wire an ElevenLabsAccess node)."
    },
    {
      "name": "text",
      "type": "String",
      "widget": {
        "kind": "textarea"
      },
      "required": true,
      "description": "The text to speak."
    },
    {
      "name": "voice",
      "type": "String",
      "required": true,
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "free_text": true,
        "sources": [
          {
            "kind": "list",
            "get": "https://api.elevenlabs.io/v1/voices",
            "items": "voices",
            "label": "name",
            "value": "voice_id"
          }
        ]
      },
      "label": "Voice",
      "placeholder": "Pick a voice, or paste a voice id"
    },
    {
      "name": "model",
      "type": "String",
      "default": "eleven_multilingual_v2",
      "widget": {
        "kind": "select",
        "options": [
          "eleven_multilingual_v2",
          "eleven_v3",
          "eleven_flash_v2_5",
          "eleven_turbo_v2_5"
        ]
      },
      "label": "Model"
    },
    {
      "name": "outputFormat",
      "type": "String",
      "default": "mp3_44100_128",
      "widget": {
        "kind": "select",
        "options": [
          "mp3_44100_128",
          "mp3_44100_192",
          "pcm_16000",
          "pcm_44100",
          "ulaw_8000",
          "opus_48000_32",
          "opus_48000_64",
          "opus_48000_96",
          "opus_48000_128",
          "opus_48000_192"
        ]
      },
      "label": "Output format",
      "description": "mp3 for anything that plays a file, pcm or ulaw for telephony, opus_48000_* for a WhatsApp voice note (stored as Ogg Opus)."
    },
    {
      "name": "stability",
      "type": "Number",
      "required": false,
      "widget": {
        "kind": "number",
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "description": "Voice stability (0 varied, 1 monotone). Absent = the voice's own setting."
    },
    {
      "name": "similarityBoost",
      "type": "Number",
      "required": false,
      "widget": {
        "kind": "number",
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "description": "How closely the output sticks to the voice. Absent = the voice's own setting."
    },
    {
      "name": "speed",
      "type": "Number",
      "required": false,
      "widget": {
        "kind": "number",
        "min": 0.7,
        "max": 1.2,
        "step": 0.05
      },
      "description": "Speaking speed multiplier. Absent = the voice's own setting."
    }
  ],
  "outputs": [
    {
      "name": "file",
      "type": "Audio",
      "description": "The spoken audio."
    },
    {
      "name": "filename",
      "type": "String"
    },
    {
      "name": "mimeType",
      "type": "String"
    },
    {
      "name": "sizeBytes",
      "type": "Number"
    }
  ],
  "display": {
    "kind": "media",
    "output": "file"
  }
}
