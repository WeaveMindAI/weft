{
  "type": "OpenAIModel",
  "label": "OpenAI Model",
  "description": "Pick an OpenAI model to serve LLM calls directly on OpenAI's API, on the connection an OpenAI Access node holds; wire the provider output into any LLM node.",
  "tags": [
    "ai",
    "provider",
    "model",
    "gpt",
    "llm"
  ],
  "icon": "Cpu",
  "color": "#6b6b99",
  "inputs": [
    {
      "name": "access",
      "type": "Access[openai]",
      "required": true,
      "accepts": ["wire"],
      "description": "The OpenAI connection: wire an OpenAI Access node's `access`."
    },
    {
      "name": "model",
      "type": "String",
      "required": true,
      "widget": {
        "kind": "remote_select",
        "access": "access",
        "freeText": true,
        "sources": [
          {
            "kind": "list",
            "get": "https://api.openai.com/v1/models",
            "items": "data",
            "label": "id",
            "value": "id"
          }
        ]
      },
      "label": "Model",
      "placeholder": "gpt-5.6-luna"
    }
  ],
  "outputs": [
    {
      "name": "provider",
      "type": "LlmProvider",
      "description": "Wire it into an LLM node's provider input."
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "all",
        "of": [
          { "kind": "not", "of": { "kind": "input_wired", "port": "model" } },
          { "kind": "not", "of": { "kind": "value", "field": "model", "nonempty": true } }
        ]
      },
      "then": {
        "message": "OpenAIModel '{id}' has no model; name one on the node or wire one in.",
        "level": "runtime",
        "field": "model"
      }
    }
  ]
}
