{
  "type": "LlmModerate",
  "label": "Moderate",
  "description": "Classify text for content safety through OpenAI's moderation endpoint (free, no usage caps); wire an OpenAI Access node. Emits whether the text flags, which categories, and per-category scores.",
  "tags": [
    "ai",
    "moderation",
    "llm"
  ],
  "icon": "ShieldAlert",
  "color": "#7C3AED",
  "inputs": [
    {
      "name": "access",
      "type": "Access[openai]",
      "required": true,
      "accepts": ["wire"],
      "description": "The OpenAI connection: wire an OpenAI Access node's `access` (the one feeding your OpenAI Model nodes works here too)."
    },
    {
      "name": "model",
      "type": "String",
      "default": "omni-moderation-latest",
      "description": "The OpenAI moderation model.",
      "widget": {
        "kind": "select",
        "freeText": true,
        "options": [
          "omni-moderation-latest",
          "text-moderation-latest"
        ]
      }
    },
    {
      "name": "text",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "label": "Text"
    }
  ],
  "outputs": [
    {
      "name": "flagged",
      "type": "Boolean"
    },
    {
      "name": "categories",
      "type": "List[String]",
      "description": "The categories that flagged."
    },
    {
      "name": "scores",
      "type": "JsonDict"
    }
  ]
}
