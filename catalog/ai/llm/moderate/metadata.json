{
  "type": "LlmModerate",
  "label": "Moderate",
  "description": "Classify text for content safety through OpenAI's moderation endpoint (free, no usage caps); wire an OpenAIProvider. Emits whether the text flags, which categories, and per-category scores.",
  "tags": [
    "ai",
    "moderation",
    "llm"
  ],
  "icon": "ShieldAlert",
  "color": "#7C3AED",
  "inputs": [
    {
      "name": "provider",
      "type": "LlmProvider",
      "required": true,
      "description": "Wire an OpenAIProvider; only its connection is used, so the one feeding your chat nodes works here too."
    },
    {
      "name": "model",
      "type": "String",
      "default": "omni-moderation-latest",
      "description": "The OpenAI moderation model.",
      "widget": {
        "kind": "select",
        "free_text": true,
        "options": [
          "omni-moderation-latest",
          "text-moderation-latest"
        ]
      }
    },
    {
      "name": "text",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "label": "Text"
    }
  ],
  "outputs": [
    {
      "name": "flagged",
      "type": "Boolean"
    },
    {
      "name": "categories",
      "type": "List[String]",
      "description": "The categories that flagged."
    },
    {
      "name": "scores",
      "type": "JsonDict"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
