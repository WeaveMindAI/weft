{
  "type": "OpenRouterAccess",
  "label": "OpenRouter Access",
  "description": "Connect OpenRouter for the project's AI calls: pick the built-in credits connection, or bring your own OpenRouter API key. Wire the access output into every OpenRouter node; one connection, picked once, however many calls consume it.",
  "tags": [
    "ai",
    "access",
    "credentials",
    "key"
  ],
  "icon": "KeyRound",
  "color": "#6b6b99",
  "service": {
    "service": "openrouter",
    "label": "OpenRouter",
    "doors": ["shared", "own"],
    "acquisition": {
      "kind": "static",
      "fields": [
        {
          "name": "key",
          "label": "API key",
          "placeholder": "sk-or-..."
        }
      ]
    },
    "auth": [
      {
        "kind": "header",
        "name": "Authorization",
        "value": "Bearer {key}"
      }
    ],
    "test": {
      "url": "https://openrouter.ai/api/v1/key",
      "captures": [
        {
          "name": "key_label",
          "path": "data.label",
          "optional": true
        }
      ]
    },
    "identity": "{key_label}",
    "verification": {
      "rung": "reports_validity",
      "cost": "free"
    },
    "own_page": {
      "guide": {
        "link": "https://openrouter.ai/keys",
        "steps": [
          "Open openrouter.ai/keys and create an API key.",
          "Paste it below and name the connection."
        ]
      }
    }
  },
  "inputs": [
    {
      "name": "connection",
      "type": "Access",
      "exposure": "config",
      "widget": {
        "kind": "access"
      },
      "label": "Connection"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access",
      "required": false,
      "description": "The OpenRouter access: wire it into an OpenRouterInference node's account input."
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "not",
        "of": {
          "kind": "config_nonempty",
          "field": "connection"
        }
      },
      "then": {
        "message": "OpenRouterAccess '{id}' has no connection picked; pick one on the node.",
        "level": "runtime",
        "field": "connection"
      }
    }
  ],
  "requires_infra": false
}
