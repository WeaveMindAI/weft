{
  "type": "PostgresAccess",
  "label": "Postgres Access",
  "description": "Connect to an existing Postgres database (managed like Neon, Supabase, RDS, Cloud SQL, or self-hosted) by host, port, database, user and password.",
  "tags": [
    "postgres",
    "database",
    "sql",
    "access"
  ],
  "icon": "Database",
  "color": "#336791",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "widget": {
        "kind": "access"
      },
      "label": "Database"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access",
      "description": "Wire into the Postgres query and write nodes."
    }
  ],
  "service": {
    "service": "postgres",
    "label": "Postgres",
    "identity": "{user}@{host}/{database}",
    "acquisition": {
      "kind": "static",
      "fields": [
        {
          "name": "host",
          "label": "Host",
          "secret": false,
          "placeholder": "db.example.com"
        },
        {
          "name": "port",
          "label": "Port",
          "secret": false,
          "optional": true,
          "placeholder": "5432"
        },
        {
          "name": "database",
          "label": "Database",
          "secret": false,
          "placeholder": "postgres"
        },
        {
          "name": "user",
          "label": "User",
          "secret": false,
          "placeholder": "postgres"
        },
        {
          "name": "password",
          "label": "Password"
        },
        {
          "name": "sslmode",
          "label": "TLS",
          "secret": false,
          "optional": true,
          "placeholder": "require (or verify-ca / verify-full; disable turns TLS off)"
        }
      ]
    }
  }
}
