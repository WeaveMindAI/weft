{
  "type": "GitHubAppAccess",
  "label": "GitHub App Access",
  "description": "Sign in as a GitHub App installation: paste the app id, installation id, and private key; the runtime mints a short-lived JWT and exchanges it for a one-hour installation token, lazily, on every expiry. Wire the access output into GitHub action nodes.",
  "category": "Data",
  "tags": [
    "github",
    "access",
    "app",
    "jwt"
  ],
  "icon": "Github",
  "color": "#24292f",
  "service": {
    "service": "github_app",
    "label": "GitHub App",
    "acquisition": {
      "kind": "mint_jwt",
      "fields": [
        {
          "name": "app_id",
          "label": "App ID",
          "secret": false
        },
        {
          "name": "installation_id",
          "label": "Installation ID",
          "secret": false
        },
        {
          "name": "private_key",
          "label": "Private key (PEM)"
        }
      ],
      "claims": {
        "iss": "{app_id}"
      },
      "jwt_ttl_secs": 540,
      "exchange": {
        "url": "https://api.github.com/app/installations/{installation_id}/access_tokens",
        "token_path": "token",
        "expires_path": "expires_at"
      }
    },
    "auth": [
      {
        "kind": "header",
        "name": "Authorization",
        "value": "Bearer {token}"
      }
    ],
    "test": {
      "url": "https://api.github.com/installation/repositories",
      "captures": [
        {
          "name": "repositories",
          "path": "repositories"
        }
      ]
    }
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "exposure": "config",
      "widget": {
        "kind": "access"
      },
      "label": "Installation"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access",
      "required": false,
      "description": "The GitHub App installation's access: wire it into GitHub action nodes."
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "not",
        "of": {
          "kind": "config_nonempty",
          "field": "account"
        }
      },
      "then": {
        "message": "GitHubAppAccess '{id}' has no connected installation; connect one on the node.",
        "level": "runtime",
        "field": "account"
      }
    }
  ]
}
