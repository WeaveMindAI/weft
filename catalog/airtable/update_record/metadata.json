{
  "type": "AirtableUpdateRecord",
  "label": "Airtable: Update Record",
  "description": "Change some of a record's fields; fields you don't name keep their values.",
  "tags": [
    "airtable",
    "record",
    "update"
  ],
  "icon": "TableProperties",
  "color": "#f82b60",
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "required": true,
      "requiresScopes": [
        "data.records:write"
      ],
      "description": "The Airtable access (wire an AirtableAccess node)."
    },
    {
      "name": "base",
      "type": "String",
      "required": true,
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "sources": [
          {
            "kind": "list",
            "requires": [
              "schema.bases:read"
            ],
            "get": "https://api.airtable.com/v0/meta/bases",
            "items": "bases",
            "label": "name",
            "value": "id",
            "page": {
              "cursor_param": "offset",
              "cursor_path": "offset"
            }
          },
          {
            "kind": "from_url",
            "pattern": "(app[A-Za-z0-9]+)"
          }
        ]
      },
      "label": "Base",
      "placeholder": "Pick a base, or paste its link"
    },
    {
      "name": "table",
      "type": "String",
      "required": true,
      "widget": {
        "kind": "remote_select",
        "access": "account",
        "depends_on": [
          "base"
        ],
        "sources": [
          {
            "kind": "list",
            "requires": [
              "schema.bases:read"
            ],
            "get": "https://api.airtable.com/v0/meta/bases/{base}/tables",
            "items": "tables",
            "label": "name",
            "value": "id"
          },
          {
            "kind": "from_url",
            "pattern": "(tbl[A-Za-z0-9]+)"
          }
        ]
      },
      "label": "Table",
      "placeholder": "Pick a table, or paste its link"
    },
    {
      "name": "recordId",
      "type": "String",
      "required": true,
      "description": "The record to change (rec..., from a search or trigger)."
    },
    {
      "name": "fields",
      "type": "JsonDict",
      "required": true,
      "description": "The fields to change, keyed by column name."
    },
    {
      "name": "typecast",
      "type": "Boolean",
      "exposure": "config",
      "default": true,
      "widget": {
        "kind": "checkbox"
      },
      "label": "Typecast values",
      "description": "Let Airtable coerce strings into selects, dates, collaborators, and links."
    }
  ],
  "outputs": [
    {
      "name": "recordId",
      "type": "String",
      "required": false
    },
    {
      "name": "record",
      "type": "JsonDict",
      "required": false,
      "description": "The updated record."
    }
  ]
}
