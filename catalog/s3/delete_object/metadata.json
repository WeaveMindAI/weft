{
  "type": "S3DeleteObject",
  "label": "S3: Delete Object",
  "description": "Delete one object from an S3-compatible bucket.",
  "tags": [
    "s3",
    "storage",
    "object"
  ],
  "icon": "Trash2",
  "color": "#E25444",
  "inputs": [
    {
      "name": "account",
      "type": "Access[s3]", "accepts": ["wire"],
      "required": true,
      "description": "The object store access (wire an S3Access node)."
    },
    {
      "name": "bucket",
      "type": "String",
      "required": true,
      "label": "Bucket"
    },
    {
      "name": "key",
      "type": "String",
      "required": true,
      "label": "Key"
    }
  ],
  "outputs": [
    {
      "name": "done",
      "type": "Boolean"
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "value",
        "field": "bucket",
        "matches": "^\\.{0,2}$"
      },
      "then": {
        "message": "S3DeleteObject '{id}': `bucket` is empty, `.` or `..`, which no URL can address; name a real bucket.",
        "level": "structural",
        "severity": "error",
        "field": "bucket"
      }
    },
    {
      "when": {
        "kind": "value",
        "field": "key",
        "matches": "(^|/)\\.\\.?(/|$)"
      },
      "then": {
        "message": "S3DeleteObject '{id}': `key` has a `.` or `..` path segment, which URL normalization collapses into a different key; rename the object.",
        "level": "structural",
        "severity": "error",
        "field": "key"
      }
    }
  ]
}
