{
  "type": "S3Access",
  "label": "S3 Access",
  "description": "Connect an S3-compatible object store (AWS S3, Cloudflare R2, MinIO, ...) with its endpoint, region and key pair.",
  "tags": [
    "s3",
    "r2",
    "storage",
    "access"
  ],
  "icon": "Database",
  "color": "#e25444",
  "service": {
    "service": "s3",
    "label": "S3",
    "acquisition": {
      "kind": "static",
      "fields": [
        {
          "name": "endpoint",
          "label": "Endpoint",
          "secret": false,
          "placeholder": "https://s3.us-east-1.amazonaws.com"
        },
        {
          "name": "region",
          "label": "Region",
          "secret": false,
          "placeholder": "us-east-1"
        },
        {
          "name": "access_key_id",
          "label": "Access key ID",
          "secret": false
        },
        {
          "name": "secret_access_key",
          "label": "Secret access key"
        }
      ]
    },
    "auth": [
      {
        "kind": "base_url",
        "value": "{endpoint}"
      },
      {
        "kind": "sign",
        "with": {
          "kind": "sigv4",
          "service": "s3",
          "region": "{region}",
          "access_key_id": "{access_key_id}",
          "secret_access_key": "{secret_access_key}"
        }
      }
    ],
    "test": {
      "url": "https://storage/"
    }
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access",
      "widget": {
        "kind": "access"
      },
      "label": "Store"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access",
      "description": "Wire into the S3 nodes."
    }
  ]
}
