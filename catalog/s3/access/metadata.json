{
  "type": "S3Access",
  "label": "S3 Access",
  "description": "Connect an S3-compatible object store (AWS S3, Cloudflare R2, MinIO, ...) with its endpoint, region and key pair.",
  "tags": [
    "s3",
    "r2",
    "storage",
    "access"
  ],
  "icon": "Database",
  "color": "#e25444",
  "service": {
    "service": "s3",
    "label": "S3",
    "acquisition": {
      "kind": "static",
      "ways": [
        {
          "fields": [
            {
              "name": "endpoint",
              "label": "Endpoint",
              "secret": false,
              "placeholder": "https://s3.us-east-1.amazonaws.com"
            },
            {
              "name": "region",
              "label": "Region",
              "secret": false,
              "placeholder": "us-east-1"
            },
            {
              "name": "accessKeyId",
              "label": "Access key ID",
              "secret": false
            },
            {
              "name": "secretAccessKey",
              "label": "Secret access key"
            }
          ]
        }
      ]
    },
    "auth": [
      {
        "kind": "base_url",
        "value": "{endpoint}"
      },
      {
        "kind": "sign",
        "with": {
          "kind": "sigv4",
          "service": "s3",
          "region": "{region}",
          "accessKeyId": "{accessKeyId}",
          "secretAccessKey": "{secretAccessKey}"
        }
      }
    ],
    "test": {
      "url": "https://storage/"
    }
  },
  "inputs": [
    {
      "name": "account",
      "type": "Access[s3]",
      "widget": {
        "kind": "access"
      },
      "label": "Store"
    }
  ],
  "outputs": [
    {
      "name": "access",
      "type": "Access[s3]",
      "description": "Wire into the S3 nodes."
    }
  ]
}
