{
  "type": "S3PutObject",
  "label": "S3: Put Object",
  "description": "Upload text as an object to an S3-compatible bucket.",
  "tags": [
    "s3",
    "r2",
    "storage",
    "upload"
  ],
  "icon": "Database",
  "color": "#e25444",
  "inputs": [
    {
      "name": "account",
      "type": "Access[s3]", "accepts": ["wire"],
      "required": true,
      "description": "The object store access (wire an S3Access node)."
    },
    {
      "name": "bucket",
      "type": "String",
      "required": true,
      "label": "Bucket"
    },
    {
      "name": "key",
      "type": "String",
      "required": true,
      "label": "Key",
      "placeholder": "path/to/object.txt"
    },
    {
      "name": "content",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true,
      "label": "Content"
    }
  ],
  "outputs": [
    {
      "name": "etag",
      "type": "String",
      "description": "The stored object's ETag."
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "value",
        "field": "bucket",
        "matches": "^\\.{0,2}$"
      },
      "then": {
        "message": "S3PutObject '{id}': `bucket` is empty, `.` or `..`, which no URL can address; name a real bucket.",
        "level": "structural",
        "severity": "error",
        "field": "bucket"
      }
    },
    {
      "when": {
        "kind": "value",
        "field": "key",
        "matches": "(^|/)\\.\\.?(/|$)"
      },
      "then": {
        "message": "S3PutObject '{id}': `key` has a `.` or `..` path segment, which URL normalization collapses into a different key; rename the object.",
        "level": "structural",
        "severity": "error",
        "field": "key"
      }
    }
  ]
}
