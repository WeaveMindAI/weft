{
  "type": "BaileyPresence",
  "label": "WhatsApp Presence (Baileys)",
  "description": "Show a WhatsApp presence state in a chat (typing, recording, online, offline). Send `composing` before a slow reply so the other side sees typing dots.",
  "tags": [
    "whatsapp",
    "baileys",
    "presence",
    "typing"
  ],
  "icon": "PenLine",
  "color": "#25D366",
  "inputs": [
    {
      "name": "bridge",
      "type": "Infra",
      "required": true,
      "description": "The `bridge` output of the BaileyBridge node to talk through."
    },
    {
      "name": "chatId",
      "type": "String",
      "required": true
    },
    {
      "name": "presence",
      "type": "String",
      "default": "composing",
      "widget": {
        "kind": "select",
        "options": [
          "composing",
          "recording",
          "paused",
          "available",
          "unavailable"
        ]
      }
    }
  ],
  "outputs": [
    {
      "name": "done",
      "type": "Boolean"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
