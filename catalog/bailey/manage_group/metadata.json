{
  "type": "BaileyManageGroup",
  "label": "WhatsApp Manage Group (Baileys)",
  "description": "Create a WhatsApp group, add/kick/promote/demote participants, or rename/describe it. `create` needs `name` and `participants` and outputs the new `groupId`; every other action needs `groupId`, plus `participants` for participant actions, `name` for `rename`, `description` for `describe`.",
  "tags": [
    "whatsapp",
    "baileys",
    "group"
  ],
  "icon": "Users",
  "color": "#25D366",
  "inputs": [
    {
      "name": "bridge",
      "type": "Infra",
      "required": true,
      "description": "The `bridge` output of the BaileyBridge node to talk through."
    },
    {
      "name": "action",
      "type": "String",
      "default": "create",
      "widget": {
        "kind": "select",
        "options": [
          "create",
          "add",
          "kick",
          "promote",
          "demote",
          "rename",
          "describe"
        ]
      }
    },
    {
      "name": "groupId",
      "type": "String"
    },
    {
      "name": "name",
      "type": "String"
    },
    {
      "name": "description",
      "type": "String",
      "widget": { "kind": "textarea" }
    },
    {
      "name": "participants",
      "type": "List[String]"
    }
  ],
  "outputs": [
    {
      "name": "groupId",
      "type": "String"
    }
  ],
  "validate": [
    {
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "value",
            "field": "action",
            "oneOf": [
              "add",
              "kick",
              "promote",
              "demote",
              "rename",
              "describe"
            ]
          },
          {
            "kind": "not",
            "of": {
              "kind": "input_satisfied",
              "port": "groupId"
            }
          }
        ]
      },
      "then": {
        "message": "BaileyManageGroup '{id}' acts on an existing group but has no `groupId`. Give the id of the group to change.",
        "level": "structural",
        "severity": "error",
        "port": "groupId"
      }
    },
    {
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "any",
            "of": [
              {
                "kind": "any",
                "of": [
                  {
                    "kind": "value",
                    "field": "action",
                    "equals": "create"
                  },
                  {
                    "kind": "all",
                    "of": [
                      {
                        "kind": "not",
                        "of": {
                          "kind": "value",
                          "field": "action"
                        }
                      },
                      {
                        "kind": "not",
                        "of": {
                          "kind": "input_wired",
                          "port": "action"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "value",
                "field": "action",
                "equals": "rename"
              }
            ]
          },
          {
            "kind": "not",
            "of": {
              "kind": "input_satisfied",
              "port": "name"
            }
          }
        ]
      },
      "then": {
        "message": "BaileyManageGroup '{id}' creates or renames a group but has no `name`. Give the group's name.",
        "level": "structural",
        "severity": "error",
        "port": "name"
      }
    },
    {
      "when": {
        "kind": "all",
        "of": [
          {
            "kind": "any",
            "of": [
              {
                "kind": "any",
                "of": [
                  {
                    "kind": "value",
                    "field": "action",
                    "equals": "create"
                  },
                  {
                    "kind": "all",
                    "of": [
                      {
                        "kind": "not",
                        "of": {
                          "kind": "value",
                          "field": "action"
                        }
                      },
                      {
                        "kind": "not",
                        "of": {
                          "kind": "input_wired",
                          "port": "action"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "value",
                "field": "action",
                "oneOf": [
                  "add",
                  "kick",
                  "promote",
                  "demote"
                ]
              }
            ]
          },
          {
            "kind": "not",
            "of": {
              "kind": "value",
              "field": "participants",
              "nonempty": true
            }
          }
        ]
      },
      "then": {
        "message": "BaileyManageGroup '{id}' needs `participants` for this action. List the people it applies to.",
        "level": "structural",
        "severity": "error",
        "port": "participants"
      }
    }
  ]
}
