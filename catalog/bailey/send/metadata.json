{
  "type": "BaileySend",
  "label": "WhatsApp Send (Baileys)",
  "description": "Send a WhatsApp text message. `to` is a jid (`1234567890@s.whatsapp.net`).",
  "tags": [
    "whatsapp",
    "baileys",
    "send",
    "message"
  ],
  "icon": "MessageCircle",
  "color": "#25D366",
  "inputs": [
    {
      "name": "bridge",
      "type": "Infra",
      "required": true,
      "description": "The `bridge` output of the BaileyBridge node to talk through."
    },
    {
      "name": "to",
      "type": "String",
      "required": true
    },
    {
      "name": "message",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "messageId",
      "type": "String"
    }
  ],
  "features": {
    "catchErrors": true
  }
}
