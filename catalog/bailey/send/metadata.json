{
  "type": "BaileySend",
  "label": "WhatsApp Send (Baileys)",
  "description": "Send a text message via the project's WhatsApp bridge. Wire `endpointUrl` from a BaileyBridge; set `to` to a jid (e.g. `1234567890@s.whatsapp.net`) and `message` to the text body.",
  "tags": [
    "whatsapp",
    "baileys",
    "send",
    "message"
  ],
  "icon": "MessageCircle",
  "color": "#25D366",
  "inputs": [
    {
      "name": "endpointUrl",
      "type": "String",
      "required": true
    },
    {
      "name": "to",
      "type": "String",
      "required": true
    },
    {
      "name": "message",
      "type": "String",
      "widget": { "kind": "textarea" },
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "messageId",
      "type": "String"
    }
  ],
  "requires_infra": false
}
