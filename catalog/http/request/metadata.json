{
  "type": "HttpRequest",
  "label": "HTTP Request",
  "description": "Make an outbound HTTP request. Supports GET/POST/PUT/PATCH/DELETE with JSON body and custom headers. A request that gets no answer at all (an unreachable host, a dropped connection, a body that cannot be read) is a failure, which `error` catches when it is wired. An answer with an error status (404, 500) is not a failure: `status` and `ok` carry it.",
  "tags": [
    "http",
    "api",
    "fetch",
    "request"
  ],
  "icon": "Send",
  "color": "#06b6d4",
  "inputs": [
    {
      "name": "url",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "type": "JsonDict"
    },
    {
      "name": "headers",
      "type": "Dict[String, String]"
    },
    {
      "name": "method",
      "type": "String",
      "required": true,
      "widget": {
        "kind": "select",
        "options": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE",
          "HEAD",
          "OPTIONS"
        ]
      },
      "default": "GET",
      "label": "Method"
    }
  ],
  "outputs": [
    {
      "name": "status",
      "type": "Number"
    },
    {
      "name": "body",
      "type": "JsonDict | String"
    },
    {
      "name": "ok",
      "type": "Boolean"
    }
  ],
  "features": {
    "catchErrors": true
  },
  "requires_infra": false
}
