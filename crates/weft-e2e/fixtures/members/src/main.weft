# A program with members. `hook` is the author's route, gated by the
# author's own key set; `theirs` is a key set each member connects for
# themselves (`@member_filled`), so every run through `hook` needs to
# know which member it is for. `probe` shows which member's connection the run got,
# and writes a file into that member's storage. `open` is an ungated
# route, where naming a member is refused.

keys = ApiKeyAuth
hook = Route -> (text: String) { path: "__E2E_PATH__/hook", method: "POST" }
hook.auth = keys.access

theirs = ApiKeyAuth { account: @member_filled }
probe = MemberProbe
probe.text = hook.text
probe.key = theirs.access
answer = Reply
answer.body = probe.body

open = Route -> (text: String) { path: "__E2E_PATH__/open", method: "POST" }
echo = Reply
echo.body = open.text
