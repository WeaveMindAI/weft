# Two programs in one file, sharing an upstream node.
#
#   shared ─┬─► gate_x ─► out_x     (fired by start_x)
#           └─► gate_y ─► out_y     (fired by start_y)
#
#   gate_x ─► side_x                (mine, but no output asks for it)
#
# `shared` feeds both programs. A fire of `start_x` runs its own program
# and has to leave the other alone: `shared` still emits down every wire
# it has, so `gate_y` receives a pulse it cannot act on (its permission
# comes from `start_y`, which did not fire). The rig asserts that pulse
# leaves NO trace on `gate_y` (another program is not this run's
# business) and the run completes instead of parking forever and ending
# stuck. `side_x` is different: it is in the fired program, reachable
# from `start_x`, but no output depends on it, so it journals exactly one
# `outside_this_run` skip, the hint that its author forgot `_is_output`.

shared = Text { value: "shared" }

start_x = HumanTrigger {
  title: "Start X"
  fields: [{ "kind": "approve_reject", "key": "go" }]
}
gate_x = Cast -> (value: String) {
  _should_flow: start_x.go_approved
  value: shared.value
}
out_x = Debug
out_x.data = gate_x.value
side_x = Cast -> (value: String) {
  value: gate_x.value
}

start_y = HumanTrigger {
  title: "Start Y"
  fields: [{ "kind": "approve_reject", "key": "go" }]
}
gate_y = Cast -> (value: String) {
  _should_flow: start_y.go_approved
  value: shared.value
}
out_y = Debug
out_y.data = gate_y.value
