# A live two-way WebSocket: an outside caller opens a socket at /chat; the echo
# nodes hold the conversation, replying to each message with {echo, turn}. The
# rig opens the socket, sends two messages, and asserts the echoes come back.
# TWO echoes read the same connection: inbound is broadcast to every reader
# (no node steals messages from another), so every message the caller sends
# must come back twice, once from each echo.

sock = LiveSocket { path: "__E2E_PATH__" }
echo = LiveWsEcho
echo2 = LiveWsEcho
out = Debug
out2 = Debug

echo.started = sock.started
echo2.started = sock.started
out.data = echo.done
out2.data = echo2.done
