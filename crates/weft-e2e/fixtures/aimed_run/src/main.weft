# Aimed runs: two independent roots, each with its own chain, plus a
# leaf that hangs off the first chain.
#
#   left_src  -> left  -> out_left
#   left      -> side                (a leaf on the left chain)
#   right_src -> right -> out_right
#
# The rig runs this three ways. Untargeted, every root is kicked and
# everything runs. Aimed at `out_left`, only `left_src` is kicked and
# the run is held to `out_left` and what it needs: `left` runs, `side`
# (downstream of `left`, not upstream of the target) never appears, and
# the right chain is never touched: no skip row, no cascade, nothing.
# Aimed at `left`, a node in the middle of a chain, `left` and its root
# run and nothing past it: any node is a target, and a target is "this
# node and what it needs".

left_src = Text { value: "left" }

left = Cast -> (value: String) {
  value: left_src.value
}
out_left = Debug
out_left.data = left.value

side = Cast -> (value: String) {
  value: left.value
}

right_src = Text { value: "right" }

right = Cast -> (value: String) {
  value: right_src.value
}
out_right = Debug
out_right.data = right.value
