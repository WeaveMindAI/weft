# A paid call with a QUEUE shape: the money is committed when the job is
# submitted, and the amount is only stated on a later read.
#
# The provider is the rig's own fake and the meter ships in this project
# (nodes/queue_job/mod.rs), so the test owns both ends: the node submits
# the job and reads its answer back, and the trail carries the figure the
# fake stated.

job = QueueJob -> (requestId: String)

out = Debug
out.data = job.requestId
