# A run whose node output carries the NUL character, the way a scraped
# page or a PDF does, and which fails on an error quoting it. Postgres
# refuses the character in text, so the run's record, its ending and the
# search entry built from it all have to get past it.

scrape = ExecPython -> (page: String) {
  code: "return {'page': 'scraped' + chr(0) + 'page'}"
}
explode = ExecPython(page: String) -> (done: Boolean) {
  code: "raise RuntimeError('broke on ' + page)"
}
explode.page = scrape.page
out = Debug
out.data = explode.done
