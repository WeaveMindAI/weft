# A caller's credential is a secret from the door on, and still reaches
# where the program sends it after the run paused. The route answers its
# caller at once and outlives it, so its run can pause on the form; once the
# form is answered, a fresh drive of the run (nothing of the first in its
# memory) hands the caller's credentials on to a fake service, revealed, in
# its headers and in its body. The
# rig checks the service got the token and that nothing that reads the run's
# record finds it.
#
# __E2E_PATH__ is the route's live path; __E2E_FAKE_HOST__ the fake service's
# host and port.

call = Route { path: "__E2E_PATH__/whoami", method: "POST", durable: true, outlivesCaller: true }
ack = Reply { body: { "state": "asked" } }
ack._should_flow = call.fired

review = HumanQuery {
  title: "Pass the caller's credentials on?"
  fields: [{
    "kind": "display",
    "key": "context"
  }, {
    "kind": "approve_reject",
    "key": "decision"
  }]
}
review.context = call.path

# The same credentials ride the body too, through an object whose declared
# type says where they are: the type the run resolves `body` to is what
# reveals them.
handoff = JsonObject -> (object: { caller: Dict[String, Secret[String]] }) {
  caller: call.credentials
}

forward = HttpRequest { url: "http://__E2E_FAKE_HOST__/seen", method: "POST" }
forward.headers = call.credentials
forward.body = handoff.object
forward._should_flow = review.decisionApproved

done = Debug
done.data = forward.status
