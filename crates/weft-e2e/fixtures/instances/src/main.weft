# A program with instances. `hook` is the author's route, checking its
# callers against the author's own key set; `theirs` is a key set each instance connects for
# itself (`@instance_filled`), so every run through `hook` needs to
# know which instance it is in. `probe` shows which instance's connection
# the run got, and writes a file into that instance's storage. `open` is
# an ungated route, where naming an instance is refused.

hook = Route -> (body: { text?: String, .. }) { path: "__E2E_PATH__/hook", method: "POST", auth: "api_keys" }

theirs = InstanceKey { account: @instance_filled }
probe = InstanceProbe
probe.text = hook.body.text
probe.key = theirs.access
answer = Reply
answer.body = probe.body

open = Route -> (body: { text?: String, .. }) { path: "__E2E_PATH__/open", method: "POST" }
echo = Reply
echo.body = open.body.text
