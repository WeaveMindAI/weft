# A Postgres the project runs itself. The database node brings the
# server up and hands out a connection; the query nodes use that
# connection like any other, without a password anywhere in the graph.
#
# The three statements run in order because each one waits on the
# previous one: create the table (idempotent, so a second run is a
# no-op), write a row, then read back exactly the row that was
# written. The read's `$written` port is the row the write returned,
# so the value has to survive the whole way out to weft and back into
# the database.
#
# `write` runs only once `create` has answered (`_should_flow` is the
# ordering wire, any value on it means go); `read` waits on `write`
# through the port it reads.

# Named with a dash, which the pooler reads as written, so clients sign
# in by the database's own name.
db = PostgresDatabase { database: "notes-db" }

create = PostgresExecuteQuery {
  query: "CREATE TABLE IF NOT EXISTS notes (id serial primary key, body text, tag text)"
}
create.account = db.access

write = PostgresExecuteQuery {
  query: "INSERT INTO notes (body) VALUES ('__E2E_BODY__') RETURNING body"
}
write.account = db.access
write._should_flow = create.rows

read = PostgresExecuteQuery(written: List[JsonDict]) {
  query: "SELECT body FROM notes WHERE body = ($written::jsonb -> 0 ->> 'body') ORDER BY id"
}
read.account = db.access
read.written = write.rows

out = Debug
out.data = read.rows

# A value that may not be there. `maybe` declares `photo` and simply
# never emits it (a key missing from the returned dict is no pulse), so
# the port closes, the insert's OPTIONAL `photo?` input receives
# nothing, and the query binds SQL NULL rather than refusing: the
# author said the value may be absent, and absent is an answer. Before
# this, a declared-but-silent input was indistinguishable from one
# nobody wrote, and the query refused with "declare the port and wire
# it" at a port that WAS declared and wired.
maybe = ExecPython() -> (title: String, photo: String) {
  code: "return {'title': 'no picture'}"
}
maybe._should_flow = create.rows

optional = PostgresExecuteQuery(title: String, photo?: String) {
  query: "INSERT INTO notes (body, tag) VALUES ($title, $photo) RETURNING body, tag"
}
optional.account = db.access
optional.title = maybe.title
optional.photo = maybe.photo

absent = Debug
absent.data = optional.rows

# One firing is one session, whatever stands between the program and
# Postgres: a setting made by the script's first statement is still
# there for its last. And the program signs in as its own role, which is
# no superuser.
session = PostgresExecuteQuery {
  query: "SET application_name = 'one session'; SELECT current_setting('application_name') AS name, current_user AS signed_in, (SELECT rolsuper FROM pg_roles WHERE rolname = current_user) AS superuser"
}
session.account = db.access

same = Debug
same.data = session.rows
