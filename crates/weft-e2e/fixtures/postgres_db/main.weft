# A Postgres the project runs itself. The database node brings the
# server up and hands out a connection; the query nodes use that
# connection like any other, without a password anywhere in the graph.
#
# The three statements run in order because each one waits on the
# previous one: create the table (idempotent, so a second run is a
# no-op), write a row, then read back exactly the row that was
# written. The read's `$written` port is the row the write returned,
# so the value has to survive the whole way out to weft and back into
# the database.
#
# `write` runs only once `create` has answered (`_should_flow` is the
# ordering wire, any value on it means go); `read` waits on `write`
# through the port it reads.

db = PostgresDatabase

create = PostgresExecuteQuery {
  query: "CREATE TABLE IF NOT EXISTS notes (id serial primary key, body text)"
}
create.account = db.access

write = PostgresExecuteQuery {
  query: "INSERT INTO notes (body) VALUES ('__E2E_BODY__') RETURNING body"
}
write.account = db.access
write._should_flow = create.rows

read = PostgresExecuteQuery(written: List[JsonDict]) {
  query: "SELECT body FROM notes WHERE body = ($written::jsonb -> 0 ->> 'body') ORDER BY id"
}
read.account = db.access
read.written = write.rows

out = Debug
out.data = read.rows
