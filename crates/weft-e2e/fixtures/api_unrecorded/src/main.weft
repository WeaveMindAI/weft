# Two routes that do not record their runs (`recorded: false`). The rig calls
# each and asserts what the executions listing keeps.
#
#   GET status   answers every time; its runs leave nothing behind, and
#                each one gives its at-once slot back as it ends
#   GET broken   fails every time; its run is written down afterwards

status = Route { path: "__E2E_PATH__/status", method: "GET", recorded: false, callsAtOnce: 3 }
ok = Reply { body: { "state": "fine" } }
ok._should_flow = status.method

broken = Route { path: "__E2E_PATH__/broken", method: "GET", recorded: false }
explode = ExecPython(path: String) -> (body: JsonDict) {
  code: "raise RuntimeError('the status table is gone')"
}
explode.path = broken.path
never = Reply
never.body = explode.body

# GET silent   its one path to an answer closes (the step sends nothing),
#              so the caller hears why and the run is written down failed
silent = Route { path: "__E2E_PATH__/silent", method: "GET", recorded: false }
quiet = ExecPython(path: String) -> (body: JsonDict) {
  code: "return {}"
}
quiet.path = silent.path
unsaid = Reply
unsaid.body = quiet.body
