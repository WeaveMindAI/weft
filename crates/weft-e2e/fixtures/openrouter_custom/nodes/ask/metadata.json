{
  "type": "AskCustom",
  "label": "Ask (custom provider)",
  "description": "One LLM call through a PROJECT-DEFINED provider (openrouter_custom), whose meter ships in this project. Used by the e2e rig to prove a project can define its own paid provider and have the worker discover its meter and price a real call.",
  "category": "Custom",
  "tags": [
    "ai",
    "custom",
    "provider",
    "e2e"
  ],
  "icon": "BrainCircuit",
  "color": "#7c6f9f",
  "inputs": [
    {
      "name": "prompt",
      "type": "String",
      "required": true,
      "description": "The prompt to send."
    },
    {
      "name": "model",
      "type": "String",
      "exposure": "config",
      "widget": {
        "kind": "text"
      },
      "default": "openai/gpt-4.1-nano",
      "label": "Model"
    },
    {
      "name": "systemPrompt",
      "type": "String",
      "exposure": "config",
      "label": "System prompt"
    },
    {
      "name": "connection",
      "type": "Access",
      "exposure": "config",
      "widget": {
        "kind": "access"
      },
      "label": "Connection",
      "description": "Your own connection for the custom service. A project-defined service offers no shared door, so bring your own key."
    }
  ],
  "outputs": [
    {
      "name": "response",
      "type": "String"
    }
  ],
  "requires_infra": false,
  "service": {
    "service": "openrouter_custom",
    "label": "OpenRouter (custom)",
    "acquisition": {
      "kind": "static",
      "fields": [
        {
          "name": "key",
          "label": "API key",
          "placeholder": "sk-or-..."
        }
      ]
    },
    "auth": [
      {
        "kind": "header",
        "name": "Authorization",
        "value": "Bearer {key}"
      }
    ]
  }
}
