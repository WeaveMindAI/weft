# One real LLM call through a PROJECT-DEFINED service (openrouter_custom).
# The service's meter ships in this project (nodes/ask/mod.rs), not in weft.
# The call goes to the real OpenRouter API (the custom meter keeps OpenRouter's
# real base URL and pricing, only the service NAME differs), so a real cost is
# measured by the project's own meter and lands on the journal.
#
# Driven on the user's own key: the test connects a real OpenRouter key as a
# connection for the custom service, exactly as the editor's "Your own" page
# does. A project-defined service offers no shared door, so the own
# connection is the path that exercises the whole thing.

ask = AskCustom -> (response: String) {
  model: "openai/gpt-4.1-nano",
  systemPrompt: "You answer with exactly one word, lowercase, no punctuation.",
  prompt: "What color is a clear midday sky? Answer with one word."
}

out = Debug
out.data = ask.response
