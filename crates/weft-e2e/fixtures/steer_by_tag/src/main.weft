# Runs steering each other by tag, built from the two catalog nodes
# and no Rust, on one fake SSE feed.
#
# This is the debounce shape. Every "go" event starts a run. `claim`
# tags the run with the sender and with `everyone`, `stop` asks that
# every EARLIER run carrying that sender be stopped (keeping this one),
# and the run then parks on a HumanQuery, the way a real assistant would
# wait before answering. Three events in a row for one sender leave
# exactly one run alive, the last, and the two it stopped are journaled
# as cancelled BY that run, with the tag named. A stopped run's form is
# gone: answering it does nothing, because its wake was erased, not
# merely ignored.
#
# `_should_flow` is the ordering wire: stop only after the tag is on
# the run (the tag's position is what orders concurrent stops), and ask
# the person only after the stop was queued.
#
# __E2E_FAKE_URL__ is substituted by the test with the fake SSE feed's URL.

start = TestSseTrigger -> (value: String) {
  url: "__E2E_FAKE_URL__"
  event_name: "go"
}

claim = TagRun(sender: String) {
  tags: ["everyone"]
}
claim.sender = start.value

stop = StopTagged(sender: String) {
  _should_flow: claim.done
}
stop.sender = start.value

review = HumanQuery {
  _should_flow: stop.done
  title: "Answer this sender?"
  fields: [{
    "kind": "display",
    "key": "sender"
  }, {
    "kind": "approve_reject",
    "key": "decision"
  }]
}
review.sender = start.value

out = Debug
out.data = review.decisionApproved
