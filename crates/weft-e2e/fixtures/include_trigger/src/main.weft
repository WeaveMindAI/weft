# Two routes in one program: one at the top level, one inside an included
# file. An included file is a group with a different lifetime, so a trigger
# inside it registers and fires like a trigger inside a group, under its
# address through the site (`one.door`).
#
#   POST front   the top-level route, answered by a Reply
#   POST door    the route inside lib/door.weft, included at site `one`

front = Route -> (text: String) { path: "__E2E_PATH__/front", method: "POST" }
front_body = ExecPython(text: String) -> (body: JsonDict) {
  code: "return {'body': {'heard': text, 'where': 'front'}}"
}
front_body.text = front.text
front_answer = Reply
front_answer.body = front_body.body

one = @include("lib/door.weft")
