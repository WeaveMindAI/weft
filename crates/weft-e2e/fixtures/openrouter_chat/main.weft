# A three-turn conversation through the typed ChatHistory value, with a
# media attachment, against the real provider. What it proves that the
# single-call fixture cannot: the history a call emits feeds the next
# call (the model remembers turn one at turn three), a stored image
# attached mid-conversation reaches the model (it names the color), and
# the emitted history keeps media as stored-file values (the test
# asserts no URL or base64 ever lands in it).
#
# Needs OPENROUTER_API_KEY like the openrouter fixture; the cheapest
# vision-capable model keeps the run nearly free.

auth = OpenRouterAccess

cfg = OpenRouterConfig {
  # A cheap Gemini: strong vision for pennies. (gpt-4.1-nano reliably
  # misnamed even a solid-color square; the relay link was verified
  # byte-identical, so the failure was the model, not the pipeline.)
  model: "google/gemini-2.5-flash-lite",
  systemPrompt: "You answer with exactly one word, lowercase, no punctuation.",
  temperature: 0.0,
  maxTokens: 16
}

# The remembered fact is deliberately NOT a color: turn two asks for
# the square's color, and a color-valued fact bled into that answer on
# a small model (it said "teal" about a red square).
turn1 = OpenRouterInference -> (response: String) {
  prompt: "Remember this: my dog is named Biscuit. Reply with the word: ok"
}
turn1.account = auth.access
turn1.config = cfg.config

turn2 = OpenRouterInference -> (response: String) {
  prompt: "What color is the attached square? One word."
}
turn2.history = turn1.history
turn2.media = @asset("assets/red.png", Image)
turn2.account = auth.access
turn2.config = cfg.config

turn3 = OpenRouterInference -> (response: String) {
  prompt: "What is my dog's name? One word."
}
turn3.history = turn2.history
turn3.account = auth.access
turn3.config = cfg.config

out = Debug
out.data = turn3.response

hist = Debug
hist.data = turn3.history
