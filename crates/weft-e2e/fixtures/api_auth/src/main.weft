# Gated routes: one checking callers with API keys, one with a signing
# secret. The rig connects each route the way a person does (`weft connect`,
# the install keeps the pick), then calls each route without a credential,
# with a wrong one, and with a right one, asserting the gateway's 401s and
# the `caller` identity the run receives.

secure = Route -> (body: { text?: String, .. }) { path: "__E2E_PATH__/secure", method: "POST", auth: "api_keys" }
show = ExecPython(caller: JsonDict | Null, text: String) -> (body: JsonDict) {
  code: "return {'body': {'caller': caller, 'text': text}}"
}
show.caller = secure.caller
show.text = secure.body.text
answer = Reply
answer.body = show.body

signed = Route -> (body: { text?: String, .. }) { path: "__E2E_PATH__/signed", method: "POST", auth: "hmac_sha256" }
show2 = ExecPython(caller: JsonDict | Null, text: String) -> (body: JsonDict) {
  code: "return {'body': {'caller': caller, 'text': text}}"
}
show2.caller = signed.caller
show2.text = signed.body.text
answer2 = Reply
answer2.body = show2.body
