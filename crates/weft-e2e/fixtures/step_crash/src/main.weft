# Two steps the worker dies in the middle of. Neither may run again: in
# a durable run the next worker fails both, because each may have partly
# happened, and a fast run ends cancelled.
# `caught` catches its failures and its `error` is wired, so its failure
# goes there and `handler` receives the message; `plain` has nothing
# wired on `error`, so its failure fails the run.

plain = ExecPython -> (done: Boolean) {
  code: "import time; time.sleep(600); return {'done': True}"
}
after = Debug
after.data = plain.done

caught = ExecPython -> (done: Boolean) {
  code: "import time; time.sleep(600); return {'done': True}"
}
handler = Debug
handler.data = caught.error
