#cloud-config
# The listener's own machine (`listener_machine`), on Container-Optimized
# OS: read the config and the secrets, then run weft's runtime as the
# listener alone. It holds no data: a replaced machine rebuilds what it
# holds from the database, through the broker. cloud-init runs this on
# every boot (COS keeps /etc and the units only for the life of a boot).

write_files:
  - path: /var/lib/weft/config.json
    permissions: "0644"
    content: |
      ${indent(6, config)}

  - path: /var/lib/weft/prepare.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      # Write the runtime's secrets where only root reads them.
      set -euo pipefail
      state=/var/lib/weft
      token=$(curl -sf -H 'Metadata-Flavor: Google' \
        http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token \
        | sed -E 's/.*"access_token":"([^"]+)".*/\1/')
      secret() {
        curl -sf -H "Authorization: Bearer $token" \
          "https://secretmanager.googleapis.com/v1/projects/${project}/secrets/$1/versions/latest:access" \
          | tr -d ' \n' | sed -E 's/.*"data":"([^"]+)".*/\1/' | base64 -d
      }
      umask 077
      : > "$state/secrets.env"
      for pair in ${secrets}; do
        printf '%s=%s\n' "$${pair%%=*}" "$(secret "$${pair#*=}")" >> "$state/secrets.env"
      done
%{ if access_apps != "" ~}
      secret ${access_apps} > "$state/access-apps.json"
      printf 'WEFT_ACCESS_APPS_FILE=%s\n' "$state/access-apps.json" >> "$state/secrets.env"
%{ endif ~}
      HOME=$state docker-credential-gcr configure-docker --registries ${registry_host}

  - path: /etc/systemd/system/weft-prepare.service
    permissions: "0644"
    content: |
      [Unit]
      Description=weft: read the secrets
      Wants=network-online.target
      After=network-online.target
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      # Through bash: Container-Optimized OS mounts /var noexec, so the
      # script cannot be run directly.
      ExecStart=/bin/bash /var/lib/weft/prepare.sh

  - path: /etc/systemd/system/weft-listener.service
    permissions: "0644"
    content: |
      [Unit]
      Description=weft: the listener
      Requires=weft-prepare.service docker.service
      After=weft-prepare.service docker.service
      [Service]
      Environment=HOME=/var/lib/weft
      ExecStartPre=-/usr/bin/docker rm -f weft-listener
      ExecStart=/usr/bin/docker run --rm --name weft-listener --network host \
        --env-file /var/lib/weft/secrets.env \
        -e WEFT_CONFIG=/var/lib/weft/config.json \
        -v /var/lib/weft:/var/lib/weft \
        ${runtime_image} serve --role listener
      ExecStop=/usr/bin/docker stop weft-listener
      Restart=always
      RestartSec=5

runcmd:
  - systemctl daemon-reload
  - systemctl start weft-listener.service
